// RUN: %sammine_jit --file %full | %check %full
// RUN: %sammine --file %full %O && %T/%base.exe | %check %full
// RUN: %sammine --file %full --emit llvm-opt | %check %full --check-prefix IR
// CHECK: 11 18 102

// twice(add(n)) binds an (i32) -> i32 and is one: its lambda set,
// {twice[{add}]}, holds add's set, another set, so it carries add's by
// value and can be returned. Every function value here has a known set, so
// each call through one is a direct call, and LLVM folds main to constants.
// IR-LABEL: define {{.*}} @main()
// IR-NEXT: call i32 (ptr, ...) @printf(ptr {{.*}}, i32 11, i32 18, i32 102)

import std;

let add(a: i32, b: i32) -> i32 { a + b }
let mul(a: i32, b: i32) -> i32 { a * b }
let twice(f: (i32) -> i32, x: i32) -> i32 { f(f(x)) }

let leaves(n: i32) -> (i32) -> i32 { twice(add(n)) }
// Two closures in one set: an enum of what each binds.
let either(b: bool) -> (i32) -> i32 { if b { twice(mul(3)) } else { add(100) } }

let main() -> i32 {
  let g = leaves(5);
  let h = either(true);
  let k = either(false);
  std::printf("%d %d %d\n", g(1), h(2), k(2));
  0
}

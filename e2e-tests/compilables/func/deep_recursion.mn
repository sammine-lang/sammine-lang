// RUN: %sammine_jit --file %full | %check %full
// CHECK:      10000000
// CHECK-NEXT: 10000000

// Bindings are immutable, so loops are recursion. Ten million calls deep
// must not overflow the stack, whether the call is in tail position or not.

import std;

let count_tail(i: i64, acc: i64) -> i64 {
  if i == 0i64 { acc } else { count_tail(i - 1i64, acc + 1i64) }
}

let count(i: i64) -> i64 {
  if i == 0i64 { 0i64 } else { 1i64 + count(i - 1i64) }
}

let main() -> i32 {
  std::printf("%ld\n", count_tail(10000000i64, 0i64));
  std::printf("%ld\n", count(10000000i64));
  return 0;
}

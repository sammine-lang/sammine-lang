// RUN: %sammine_jit --file %full | %check %full
// CHECK:      1
// CHECK-NEXT: 0
// CHECK-NEXT: 1

import std;

let even(x : i32) -> i32 {
  if x % 2 == 0 {
    return 1;
  } else {
    return 0;
  };
}

let main() -> i32 {
  print("{}\n", even(4));
  print("{}\n", even(7));
  print("{}\n", even(0));
  return 0;
}

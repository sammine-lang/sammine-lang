// RUN: %sammine_jit --file %full | %check %full
// CHECK:      inner_true
// CHECK-NEXT: outer_false

import std;

let main() -> i32 {
  let x : i32 = 10;
  if x > 5 {
    if x > 8 {
      print("inner_true\n");
    } else {
      print("inner_false\n");
    };
  } else {
    print("outer_false\n");
  };
  if x < 5 {
    print("fail\n");
  } else {
    print("outer_false\n");
  };
  return 0;
}

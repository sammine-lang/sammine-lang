// RUN: %sammine_jit --file %full | %check %full
// CHECK:      and false
// CHECK-NEXT: right
// CHECK-NEXT: and true
// CHECK-NEXT: or true
// CHECK-NEXT: right
// CHECK-NEXT: or false
// CHECK-NEXT: in bounds false

// && and || evaluate their right side only when the left doesn't decide:
// the guard keeps xs[3] from being read.

import std;

let right(x: bool) -> bool {
  print("right\n");
  x
}

let show(name: string, x: bool) -> unit {
  if x { print("{} true\n", name); } else { print("{} false\n", name); };
}

let main() -> i32 {
  show("and", false && right(true));
  show("and", true && right(true));
  show("or", true || right(false));
  show("or", false || right(false));
  let xs = [1i64, 2i64, 3i64];
  let i = 3i64;
  let ok = i < 3i64 && xs[i] > 0i64;
  print("in bounds {}\n", ok);
  0
}

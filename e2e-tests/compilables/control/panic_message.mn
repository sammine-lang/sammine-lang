// RUN: (%sammine_jit --file %full 2>&1 >/dev/null; echo "status $?") | %check %full
// RUN: %sammine --file %full %O
// RUN: (%T/%base.exe 2>&1 >/dev/null; echo "status $?") | %check %full
// RUN: (! %T/%base.exe 2>/dev/null) | %check %full --check-prefix OUT
// panic prints where it is, then its format with each {} an argument, on
// stderr, and ends the program with status 1. What ran before it ran.
//
// CHECK: {{.*}}panic_message.mn:22:3: panic: 7 is odd (seven, x, 2.5, true), 100% sure
// CHECK-NEXT: status 1
// OUT: half of 4 is 2
// OUT-NOT: after

import std;

let half(n: i32) -> i32 {
  if n % 2 == 0 {
    return n / 2;
  };
  let name = "seven";
  // A string, a char, a float and a bool, besides a number.
  // {.1} is a float with one digit after the point.
  panic("{} is odd ({}, {}, {.1}, {}), 100% sure", n, name, 'x', 2.5, true)
}

let main() -> i32 {
  print("half of 4 is {}\n", half(4));
  print("half of 7 is {}\n", half(7));
  print("after\n");
  0
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: C can't take or return 'Job' by value: it holds a function value, whose size depends on the closures the program makes. Pass a pointer to it
// CHECK: C can't take or return 'Job' by value: it holds a function value, whose size depends on the closures the program makes. Pass a pointer to it
// CHECK-NOT: C can't take

// A function value is its code and what it binds, as many words as the
// program's closures of its type need: a struct holding one has no layout
// C could be written against. C can hold a pointer to it, and takes a
// function of its own as a pointer to its code.

struct Job { f: (i32) -> i32, n: i32, };

reuse run(j: Job) -> i32;
reuse make() -> Job;
reuse peek(j: ptr<Job>) -> i32;
reuse apply(f: (i32) -> i32, x: i32) -> i32;

let main() -> i32 { 0 }

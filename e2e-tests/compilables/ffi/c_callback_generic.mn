// RUN: %sammine_jit --file %full | %check %full
// RUN: %sammine --file %full %O && %T/%base.exe | %check %full
// CHECK:      thread 42 for 8 bytes
// CHECK-NEXT: joined 0

// A generic function's copy is given to C as any function is: start<T>
// hands C its own copy of run, for T.

import std;

reuse pthread_create(t: ptr<u64>, attr: i64, f: (i64) -> i64, arg: i64) -> i32;
reuse pthread_join(t: u64, result: i64) -> i32;

let run<T>(arg: i64) -> i64 {
  std::printf("thread %ld for %ld bytes\n", arg, Sized<T>());
  0
}

let start<T>(arg: i64) -> unit {
  let t = alloc<u64>(1);
  *t = 0u64;
  pthread_create(t, 0i64, run<T>, arg);
  std::printf("joined %d\n", pthread_join(*t, 0i64));
  drop(t);
}

let main() -> i32 {
  start<f64>(42i64);
  0
}

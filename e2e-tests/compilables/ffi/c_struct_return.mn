// RUN: %cc -fPIC -c %dir/Inputs/c_struct_return_runtime.c -o %T/c_struct_return_runtime.o && %sammine --file %dir/Inputs/c_struct_return.mn %O && %sammine_jit --file %full %I -I %dir/Inputs | %check %full
// CHECK:      two 5 6
// CHECK-NEXT: three 10 20 30

// C returns a struct over 16 bytes through a hidden first pointer argument,
// and one of 16 bytes or less in registers.

import c_struct_return as c;
import std;

let main() -> i32 {
  let t = c::make_two(5i64);
  std::printf("two %ld %ld\n", t.a, t.b);
  let th = c::make_three(10i64, 20i64);
  std::printf("three %ld %ld %ld\n", th.a, th.b, th.c);
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      4
// CHECK-NEXT: 8

// A generic function that calls a typeclass method with its type parameter.

reuse printf(fmt: string, ...) -> i32;

let print_size<T>(x: T) -> i64 {
  Sized<T>()
}

let main() -> i32 {
  print("{}\n", print_size(42));
  print("{}\n", print_size(3.14));
  return 0;
}

reuse printf(fmt: string, ...) -> i32;
let main() -> i32 {
  print("{}\n", Sized<i32>());
  print("{}\n", Sized<i64>());
  print("{}\n", Sized<f64>());
  print("{}\n", Sized<bool>());
  return 0;
}

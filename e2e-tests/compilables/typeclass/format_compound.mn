// RUN: %sammine_jit --file %full | %check %full
// RUN: %sammine --file %full %O && %T/%base.exe | %check %full
// CHECK:      (1, true, x) [1, 2, 3] ((1, 2), 2.500000)
// CHECK-NEXT: [0.50, 2.50] (1.0, 2) Some(0.250)
// CHECK-NEXT: Some(4) None [7, 8] []
// CHECK-NEXT: {{\[\[}}1, 2], [3, 4]] [(1, 2)]
// CHECK-NEXT: 3 of 10: 0.30 (13)
// CHECK-NEXT: [1, 2, 3] is 9 chars

// A tuple and an array print part by part, each part through its own
// instance of Format, a program's too, and with the placeholder's digits.
// An Option and a Vec print by instances their modules give. format gives
// the text it would have written, which str::from makes a String of.

import str;
import vec;

struct Point { x: i32, y: i32, };

instance Format<Point> {
  let Format(p: Point, f: Formatter) -> unit { write(f, "({}, {})", p.x, p.y) }
}

let main() -> i32 {
  print("{} {} {}\n", (1, true, 'x'), [1, 2, 3], (Point { x: 1, y: 2 }, 2.5));
  print("{.2} {.1} {.3}\n", [0.5, 2.5], (1.0, 2), Option<f64>::Some(0.25));
  let v = vec::push(vec::push(vec::new<i32>(2i64), 7), 8);
  let empty = vec::new<i32>(1i64);
  print("{} {} {} {}\n", Option<i32>::Some(4), Option<string>::None, &v,
        &empty);
  print("{} {}\n", [[1, 2], [3, 4]], [Point { x: 1, y: 2 }]);
  let s = str::from(format("{} of {}: {.2}", 3, 10, 0.3));
  print("{} ({})\n", &s, str::length(&s));
  let listed = str::from(format("{}", [1, 2, 3]));
  print("{} is {} chars\n", &listed, str::length(&listed));
  0
}

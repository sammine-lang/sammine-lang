// RUN: %sammine_jit --file %full | %check %full
// CHECK:      2 -2
// CHECK-NEXT: 0
// CHECK-NEXT: 2147483647 -2147483648
// CHECK-NEXT: 0 4294967295
// CHECK-NEXT: 9223372036854775807

// A float converts to an integer by dropping the fraction, and saturates:
// NaN gives 0, and a value out of range gives the type's min or max.

import std;

// Through parameters, so the conversions happen at run time.
let to_i32(x: f64) -> i32 { x as i32 }
let to_u32(x: f64) -> u32 { x as u32 }
let to_i64(x: f32) -> i64 { x as i64 }

let main() -> i32 {
  std::printf("%d %d\n", to_i32(2.9), to_i32(-2.9));
  std::printf("%d\n", to_i32(0.0 / 0.0));
  std::printf("%d %d\n", to_i32(100000000000.0), to_i32(-100000000000.0));
  std::printf("%u %u\n", to_u32(-5.0), to_u32(100000000000.0));
  std::printf("%ld\n", to_i64(1.0f32 / 0.0f32));
  return 0;
}

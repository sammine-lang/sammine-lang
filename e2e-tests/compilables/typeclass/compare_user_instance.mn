// RUN: %sammine_jit --file %full | %check %full
// CHECK:      1 0
// CHECK-NEXT: 1 0
// CHECK-NEXT: 1
// CHECK-NEXT: 2.1

// <, > and == go through Less, Greater and Equal, as + goes through Add, so a
// type with instances can be compared, here and in a generic function.

import std;

struct Version { major: i32, minor: i32, };

instance Less<Version> {
  let Less(a: Version, b: Version) -> bool {
    a.major < b.major || (a.major == b.major && a.minor < b.minor)
  }
}

instance Greater<Version> {
  let Greater(a: Version, b: Version) -> bool { Less<Version>(b, a) }
}

instance Equal<Version> {
  let Equal(a: Version, b: Version) -> bool {
    a.major == b.major && a.minor == b.minor
  }
}

let newer<T>(a: T, b: T) -> T { if a > b { a } else { b } }

let main() -> i32 {
  let v1 = Version { major: 1, minor: 4 };
  let v2 = Version { major: 2, minor: 1 };
  std::printf("%d %d\n", v1 < v2, v2 < v1);
  std::printf("%d %d\n", v1 == Version { major: 1, minor: 4 }, v1 == v2);
  std::printf("%d\n", Less<Version>(v1, v2));
  let n = newer<Version>(v1, v2);
  std::printf("%d.%d\n", n.major, n.minor);
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// x[i] lends x to its Indexer: a Vec is still owned after indexing it, a
// parameter or a temporary can be indexed, and so can a field.
import std;
import vec;

struct Trio { a: i32, b: i32, c: i32, };

instance Indexer<Trio, i32> {
  let Indexer(t: ptr<Trio>, i: i64) -> i32 {
    if i == 0i64 { (*t).a } else if i == 1i64 { (*t).b } else { (*t).c }
  }
}

struct Holder { t: Trio, };

let last(t: Trio) -> i32 { t[2] }
let make() -> Trio { Trio { a: 7, b: 8, c: 9 } }

let main() -> i32 {
  let v = vec::push<i32>(vec::push<i32>(vec::new<i32>(1), 10), 20);
  let h = Holder { t: Trio { a: 1, b: 2, c: 3 } };
  // CHECK: 10 20 30 3 8 2
  std::printf("%d %d %d %d %d %d\n", v[0], v[1], v[0] + v[1], last(h.t),
              make()[1], h.t[1]);
  vec::delete<i32>(v);
  return 0;
}

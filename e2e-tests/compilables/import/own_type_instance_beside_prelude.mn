// RUN: %sammine --file %dir/Inputs/hashes_prelude_range.mn %O && %sammine_jit --file %full %I -I %dir/Inputs | %check %full
// CHECK: 7 99

// Two types written alike are two types: this program's Range and the
// prelude's each have a Hash instance, and each instance its own symbol,
// which spells the type by its whole name.

import hashes_prelude_range;
import std;

struct Range<T> { a: T, b: T, c: T, };

instance Hash<Range<i32>> {
  let Hash(r: Range<i32>) -> u64 { 7u64 }
}

let main() -> i32 {
  let r = Range<i32> { a: 1, b: 2, c: 3 };
  print("{} {}\n", Hash<Range<i32>>(r),
              hashes_prelude_range::hash_of_range(1));
  return 0;
}

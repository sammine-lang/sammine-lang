// RUN: %sammine --file %dir/Inputs/has_generic_struct.mn %O && %sammine --file %dir/Inputs/has_generic.mn %O && %sammine_jit --diagnostics=dev --file %full %I -I %dir/Inputs | %check %full
// CHECK:      10
// CHECK-NEXT: 20
import has_generic_struct as lib;
import has_generic;
import std;

let main() -> i32 {
  let p = lib::Point { x: 10, y: 20 };
  let q: lib::Point = has_generic::identity<lib::Point>(p);
  print("{}\n", q.x);
  print("{}\n", q.y);
  return 0;
}

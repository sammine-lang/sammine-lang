// RUN: %sammine_jit --file %full | %check %full
// RUN: %sammine --file %full %O && %asan %T/%base.exe | %check %full
// REQUIRES: asan
// CHECK:      residues 49, has 4 1, has 5 0
// CHECK-NEXT: removed 1 0, now 48
// CHECK-NEXT: chars 1

// A set holds each value once: the squares mod 97 of 0..1000 are its 49
// quadratic residues, 4 among them and 5 not.

import std;
import set;

let fill(s: set::Set<i64>, i: i64) -> set::Set<i64> {
  if i == 1000i64 {
    s
  } else {
    fill(set::insert<i64>(s, (i * i) % 97i64), i + 1i64)
  }
}

let main() -> i32 {
  let s = fill(set::new<i64>(), 0i64);
  std::printf("residues %lld, has 4 %d, has 5 %d\n", set::length<i64>(&s),
              set::contains<i64>(&s, 4i64), set::contains<i64>(&s, 5i64));
  let (s, was) = set::remove<i64>(s, 4i64);
  let (s, again) = set::remove<i64>(s, 4i64);
  std::printf("removed %d %d, now %lld\n", was, again, set::length<i64>(&s));
  set::delete<i64>(s);
  let c = set::insert<char>(set::insert<char>(set::new<char>(), 'a'), 'a');
  std::printf("chars %lld\n", set::length<char>(&c));
  set::delete<char>(c);
  0
}

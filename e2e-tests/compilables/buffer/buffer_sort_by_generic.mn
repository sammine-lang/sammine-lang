// RUN: %sammine_jit --file %full | %check %full
// CHECK: 0.500000 1.500000 2.500000 3.500000
// CHECK: 3.500000 2.500000 1.500000 0.500000
// CHECK: 7 7

import std;
import buffer;

let greater(a: f64, b: f64) -> bool { a > b }
let less(a: f64, b: f64) -> bool { a < b }
let gt_i64(a: i64, b: i64) -> bool { a > b }

let unsafe main() -> i32 {
  let xs = alloc<f64>(4i64);
  xs[0] = 2.5;
  xs[1] = 0.5;
  xs[2] = 3.5;
  xs[3] = 1.5;
  let xs = buffer::sort_by(xs, 4i64, greater);
  std::printf("%f %f %f %f\n", xs[0], xs[1], xs[2], xs[3]);
  let xs = buffer::sort_by(xs, 4i64, less);
  std::printf("%f %f %f %f\n", xs[0], xs[1], xs[2], xs[3]);
  drop(xs);
  // Zero and one elements are already sorted.
  let ys = alloc<i64>(1i64);
  ys[0] = 7i64;
  let ys = buffer::sort_by(ys, 0i64, gt_i64);
  let ys = buffer::sort_by(ys, 1i64, gt_i64);
  std::printf("%ld %ld\n", ys[0], 7i64);
  drop(ys);
  0
}

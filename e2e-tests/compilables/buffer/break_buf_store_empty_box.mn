// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: ╰─ An owned pointer must point at a value when it is stored, but it points at nothing yet

// What a buffer holds isn't followed, so a pointer stored there must hold
// its value already.

let unsafe put(b: 'buf<'ptr<'ptr<i32>>>) -> 'buf<'ptr<'ptr<i32>>> {
  b[0] = alloc<'ptr<i32>>(1);
  b
}

let main() -> i32 { 0 }

// RUN: %sammine_jit --file %full | %check %full
// CHECK: 7 7 7 2.500000 2.500000

import std;
import buffer;

let unsafe main() -> i32 {
  let xs = buffer::filled(3i64, 7i64);
  let ys = buffer::filled(2i64, 2.5);
  let none = buffer::filled(0i64, 1i64);
  std::printf("%ld %ld %ld %f %f\n", xs[0], xs[1], xs[2], ys[0], ys[1]);
  free(xs);
  free(ys);
  free(none);
  0
}

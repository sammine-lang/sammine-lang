// RUN: echo "" | %sammine_jit --file %full | %check %full
// CHECK: line of length 0

// An empty line is still a line, not end of input.

import io;
import str;

let main() -> i32 {
  case io::read_line() {
    Some(line) => {
      print("line of length {}\n", str::length(&line));
    },
    None => print("eof\n"),
  };
  0
}

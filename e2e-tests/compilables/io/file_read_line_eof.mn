// RUN: %sammine_jit --file %full | %check %full
// CHECK: first
// CHECK-NEXT: eof

import io;
import str;

let main() -> i32 {
  io::write_file("/tmp/sammine_test_eof.txt", "first\n" as ptr<char>, 6);
  let f = io::open("/tmp/sammine_test_eof.txt", "r");

  let (f, first) = io::file_read_line(f);
  case first {
    Line(line, n) => {
      let text = str::String { data: line, length: n, cap: n };
      print("{}\n", &text);
    },
    Eof => print("eof\n"),
  };

  let (f, second) = io::file_read_line(f);
  case second {
    Line(line, n) => {
      let text = str::String { data: line, length: n, cap: n };
      print("{}\n", &text);
    },
    Eof => print("eof\n"),
  };

  io::close(f);
  0
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      hello from file

import io;

let main() -> i32 {
  let content: ptr<char> = "hello from file";
  let result: i32 = io::write_file("/tmp/sammine_test_io.txt", content, 15);
  case io::read_file("/tmp/sammine_test_io.txt") {
    Line(data, n) => {
      io::println(data);
      free(data);
    },
    Eof => io::println("could not read"),
  };
  0
}

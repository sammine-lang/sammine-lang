// RUN: %sammine_jit --file %full | %check %full
// CHECK:      hello from file

import io;
import str;

let main() -> i32 {
  let content = "hello from file";
  let result: i32 = io::write_file("/tmp/sammine_test_io.txt", content, 15);
  case io::read_file("/tmp/sammine_test_io.txt") {
    Line(data, n) => {
      let text = str::String { data: data, length: n, cap: n };
      print("{}\n", &text);
    },
    Eof => print("could not read\n"),
  };
  0
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      line written ok

import io;
import str;

let main() -> i32 {
  let content = "line written ok\n" as ptr<char>;
  io::write_file("/tmp/sammine_test_handle.txt", content, 16);

  let f: io::File = io::open("/tmp/sammine_test_handle.txt", "r");

  let (f, result) = io::file_read_line(f);
  case result {
    Line(buf, n) => {
      let text = str::String { data: buf, length: n, cap: n };
      print("{}\n", &text);
    },
    Eof => print("eof\n"),
  };

  io::close(f);
  0
}

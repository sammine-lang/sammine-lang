// RUN: %sammine_jit --file %full | %check %full
// CHECK:      line written ok

import io;

let main() -> i32 {
  let content: ptr<char> = "line written ok\n";
  io::write_file("/tmp/sammine_test_handle.txt", content, 16);

  let f: 'ptr<char> = io::open("/tmp/sammine_test_handle.txt", "r");

  let (f, result) = io::file_read_line(f);
  case result {
    Line(buf, n) => {
      io::println(buf);
      free(buf);
    },
    Eof => io::println("eof"),
  };

  io::close(f);
  0
}

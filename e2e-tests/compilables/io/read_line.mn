// RUN: echo "hello stdin" | %sammine_jit --file %full | %check %full
// CHECK:      got: hello stdin (11)

import io;
import str;

let main() -> i32 {
  case io::read_line() {
    Some(text) => {
      print("got: ");
            print("{}", &text);
      print(" (");
      io::print_i64(str::length(&text));
      print(")\n");
    },
    None => print("eof\n"),
  };
  0
}

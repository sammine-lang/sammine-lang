// RUN: echo "hello stdin" | %sammine_jit --file %full | %check %full
// CHECK:      got: hello stdin (11)

import io;

let main() -> i32 {
  case io::read_line() {
    Line(line, n) => {
      print("got: ");
      print("{}", line);
      print(" (");
      io::print_i64(n);
      print(")\n");
      drop(line);
    },
    Eof => print("eof\n"),
  };
  0
}

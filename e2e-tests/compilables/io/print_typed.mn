// RUN: %sammine_jit --file %full | %check %full
// CHECK:      42
// CHECK-NEXT: 1000000
// CHECK-NEXT: 3.140000
// CHECK-NEXT: A
// CHECK-NEXT: true
// CHECK-NEXT: false

import io;

let main() -> i32 {
  io::print_i32(42);
  print("\n");
  io::print_i64(1000000);
  print("\n");
  io::print_f64(3.14);
  print("\n");
  io::print_char('A');
  print("\n");
  io::print_bool(true);
  print("\n");
  io::print_bool(false);
  print("\n");
  0
}

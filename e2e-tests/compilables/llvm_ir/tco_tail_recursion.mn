// RUN: %sammine --file %full %O --emit llvm-opt 2>&1 | %check %full
// Verify LLVM's tailcallelim pass transforms self-recursive tail calls.
// After optimization, count() should not contain a recursive call to itself.
// This file has no main, so it is a library, and count stays a function of
// its own instead of being inlined.

export let count(n: i64, acc: i64) -> i64 {
  if n == 0i64 { acc }
  else { count(n - 1i64, acc + 1i64) }
}

// CHECK:      define i64 @"tco_tail_recursion::count"(i64 %0, i64 %1) local_unnamed_addr
// CHECK-NOT:  call{{.*}}@"tco_tail_recursion::count"
// CHECK:      }

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      3
// CHECK-NEXT: 7
// CHECK-NEXT: 6

import std;

type Flags = Read(1) | Write(2) | Exec(4);

let main() -> i32 {
  let rw: Flags = Read | Write;
  print("{}\n", rw);

  let all: Flags = Read | Write | Exec;
  print("{}\n", all);

  let wx: Flags = Write | Exec;
  print("{}\n", wx);

  return 0;
}

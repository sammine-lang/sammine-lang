// RUN: %sammine_jit --file %full | %check %full
// CHECK:      red
// CHECK-NEXT: has value: 99
// CHECK-NEXT: no value

import std;

type Color = Red | Green | Blue;

let main() -> i32 {
  let c: Color = Red;
  let x: Option<i32> = Some(99);
  let y: Option<i32> = None;

  case c {
    Red => print("red\n"),
    Green => print("green\n"),
    Blue => print("blue\n"),
  };

  case x {
    Some(v) => print("has value: {}\n", v),
    None => print("no value\n"),
  };

  case y {
    Some(v) => print("has value: {}\n", v),
    None => print("no value\n"),
  };

  return 0;
}

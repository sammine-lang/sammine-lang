// RUN: %sammine_jit --file %full | %check %full
// CHECK:      negative
// CHECK-NEXT: zero
// CHECK-NEXT: positive

import std;

let sign(x: i32) -> i32 {
  case x {
    -1 => print("negative\n"),
    0 => print("zero\n"),
    1 => print("positive\n"),
    _ => print("other\n"),
  };
  return 0;
}

let main() -> i32 {
  sign(-1);
  sign(0);
  sign(1);
  return 0;
}

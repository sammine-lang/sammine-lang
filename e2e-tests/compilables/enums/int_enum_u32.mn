// RUN: %sammine_jit --file %full | %check %full
// CHECK:      1
// CHECK-NEXT: 2
// CHECK-NEXT: 4

import std;

type Flags: u32 = Read(1) | Write(2) | Exec(4);

let main() -> i32 {
  let r: Flags = Read;
  let w: Flags = Write;
  let e: Flags = Exec;
  print("{}\n", r);
  print("{}\n", w);
  print("{}\n", e);
  return 0;
}

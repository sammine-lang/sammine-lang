// RUN: %sammine_jit --file %full | %check %full
// CHECK:      mixed i32=42, i64=1234567890123
// CHECK-NEXT: reverse i64=9876543210987, i32=99

import std;

type Mixed = A(i32, i64) | B(i64, i32);

let main() -> i32 {
  let a: Mixed = Mixed::A(42, 1234567890123i64);
  let b: Mixed = Mixed::B(9876543210987i64, 99);
  case a {
    Mixed::A(x, y) => print("mixed i32={}, i64={}\n", x, y),
    Mixed::B(x, y) => print("unreachable\n"),
  };
  case b {
    Mixed::A(x, y) => print("unreachable\n"),
    Mixed::B(x, y) => print("reverse i64={}, i32={}\n", x, y),
  };
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      matched WRONLY
// CHECK-NEXT: matched CREAT

import std;

type OpenFlags = RDONLY(0) | WRONLY(1) | CREAT(64);

let check_flag(f: OpenFlags) -> i32 {
  case f {
    OpenFlags::RDONLY => print("matched RDONLY\n"),
    OpenFlags::WRONLY => print("matched WRONLY\n"),
    OpenFlags::CREAT => print("matched CREAT\n"),
  };
  return 0;
}

let main() -> i32 {
  let w: OpenFlags = OpenFlags::WRONLY;
  let c: OpenFlags = OpenFlags::CREAT;
  check_flag(w);
  check_flag(c);
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      vowel
// CHECK-NEXT: other

import std;

let check_vowel(c: char) -> i32 {
  case c {
    'a' => print("vowel\n"),
    'e' => print("vowel\n"),
    'i' => print("vowel\n"),
    _ => print("other\n"),
  };
  return 0;
}

let main() -> i32 {
  check_vowel('a');
  check_vowel('x');
  return 0;
}

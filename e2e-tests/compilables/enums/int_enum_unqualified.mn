// RUN: %sammine_jit --file %full | %check %full
// CHECK:      read
// CHECK-NEXT: write

import std;

type Mode = READ(0) | WRITE(1) | EXEC(2);

let describe(m: Mode) -> i32 {
  case m {
    READ => print("read\n"),
    WRITE => print("write\n"),
    EXEC => print("exec\n"),
  };
  return 0;
}

let main() -> i32 {
  let r: Mode = READ;
  let w: Mode = WRITE;
  describe(r);
  describe(w);
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      zero
// CHECK-NEXT: one
// CHECK-NEXT: other

import std;

let describe(x: i32) -> i32 {
  case x {
    0 => print("zero\n"),
    1 => print("one\n"),
    _ => print("other\n"),
  };
  return 0;
}

let main() -> i32 {
  describe(0);
  describe(1);
  describe(42);
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      not equal
// CHECK-NEXT: equal

import std;

let main() -> i32 {
  let a : f64 = 3.14;
  let b : f64 = 2.72;
  if a != b {
    print("not equal\n");
  } else {
    print("equal\n");
  };

  let c : f64 = 1.5;
  let d : f64 = 1.5;
  if c != d {
    print("not equal\n");
  } else {
    print("equal\n");
  };

  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      not equal
// CHECK-NEXT: equal

import std;

let main() -> i32 {
  let a : i32 = 5;
  let b : i32 = 10;
  if a != b {
    print("not equal\n");
  } else {
    print("equal\n");
  };

  let c : i32 = 7;
  let d : i32 = 7;
  if c != d {
    print("not equal\n");
  } else {
    print("equal\n");
  };

  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      and_true
// CHECK-NEXT: and_false
// CHECK-NEXT: or_true
// CHECK-NEXT: or_false
// CHECK-NEXT: lit_and_true
// CHECK-NEXT: lit_and_false
// CHECK-NEXT: lit_or_true
// CHECK-NEXT: lit_or_false

import std;

let main() -> i32 {
  // typed variables
  let a : i32 = 1;
  let b : i32 = 2;
  let c : i32 = 3;
  if a == a && b == b { print("and_true\n"); } else { print("fail\n"); };
  if a == a && b == c { print("fail\n"); } else { print("and_false\n"); };
  if a == b || b == b { print("or_true\n"); } else { print("fail\n"); };
  if a == b || b == c { print("fail\n"); } else { print("or_false\n"); };

  // bare integer literals
  if 1 == 1 && 2 == 2 { print("lit_and_true\n"); } else { print("fail\n"); };
  if 1 == 1 && 2 == 3 { print("fail\n"); } else { print("lit_and_false\n"); };
  if 1 == 2 || 2 == 2 { print("lit_or_true\n"); } else { print("fail\n"); };
  if 1 == 2 || 2 == 3 { print("fail\n"); } else { print("lit_or_false\n"); };
  return 0;
}

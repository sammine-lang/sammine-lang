// RUN: %sammine_jit --file %full | %check %full
// CHECK:      t_eq
// CHECK-NEXT: f_eq
// CHECK-NEXT: t_neq

import std;

let main() -> i32 {
  let t : bool = true;
  let f : bool = false;
  if t == true { print("t_eq\n"); } else { print("fail\n"); };
  if f == false { print("f_eq\n"); } else { print("fail\n"); };
  if t != false { print("t_neq\n"); } else { print("fail\n"); };
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      no_short
// CHECK-NEXT: yes_short
// CHECK-NEXT: and_both_true
// CHECK-NEXT: or_both_false

import std;

let main() -> i32 {
  // false && true => false (right side may or may not be evaluated)
  if false && true { print("fail\n"); } else { print("no_short\n"); };
  // true || false => true (right side may or may not be evaluated)
  if true || false { print("yes_short\n"); } else { print("fail\n"); };
  // true && true => true
  if true && true { print("and_both_true\n"); } else { print("fail\n"); };
  // false || false => false
  if false || false { print("fail\n"); } else { print("or_both_false\n"); };
  return 0;
}

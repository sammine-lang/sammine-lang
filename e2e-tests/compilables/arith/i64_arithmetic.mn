// RUN: %sammine_jit --file %full | %check %full
// CHECK:      3000000000
// CHECK-NEXT: 1000000000
// CHECK-NEXT: 3000000000
// CHECK-NEXT: 2

import std;

let main() -> i32 {
  let a : i64 = 1000000000;
  let b : i64 = 2000000000;
  print("{}\n", a + b);
  print("{}\n", b - a);
  print("{}\n", a * 3);
  print("{}\n", b / a);
  return 0;
}

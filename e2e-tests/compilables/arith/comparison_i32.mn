// RUN: %sammine_jit --file %full | %check %full
// CHECK:      less
// CHECK-NEXT: less_equal
// CHECK-NEXT: greater
// CHECK-NEXT: greater_equal
// CHECK-NEXT: lit_less
// CHECK-NEXT: lit_less_equal
// CHECK-NEXT: lit_greater
// CHECK-NEXT: lit_greater_equal

import std;

let main() -> i32 {
  // typed variables
  let a : i32 = 3;
  let b : i32 = 5;
  if a < b { print("less\n"); } else { print("fail\n"); };
  if a <= a { print("less_equal\n"); } else { print("fail\n"); };
  if b > a { print("greater\n"); } else { print("fail\n"); };
  if b >= b { print("greater_equal\n"); } else { print("fail\n"); };

  // bare integer literals
  if 3 < 5 { print("lit_less\n"); } else { print("fail\n"); };
  if 3 <= 3 { print("lit_less_equal\n"); } else { print("fail\n"); };
  if 5 > 3 { print("lit_greater\n"); } else { print("fail\n"); };
  if 5 >= 5 { print("lit_greater_equal\n"); } else { print("fail\n"); };
  return 0;
}

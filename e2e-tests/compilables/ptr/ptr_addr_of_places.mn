// RUN: %sammine_jit --file %full | %check %full
// CHECK: 1 2 3 4 5 6

import std;

struct S { x: i32, a: [2]i32, };

let f() -> i32 { 0 }

let read_param(n: i32) -> i32 {
  let p = &n;
  *p
}

let main() -> i32 {
  let s = S { x: 2, a: [0, 3] };
  let t = (0, 4);
  let arr: [2]i32 = [0, 5];
  // A local may reuse a function's name; it is still a variable.
  let f = 6;
  std::printf("%d %d %d %d %d %d\n", read_param(1), *&s.x, *&s.a[1], *&t.1,
              *&arr[1], *&f);
  return 0;
}

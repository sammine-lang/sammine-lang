// RUN: %sammine_jit --file %full | %check %full
// CHECK:      10
// CHECK-NEXT: 20

import std;

struct Point {
  x: i32,
  y: i32,
};

let unsafe main() -> i32 {
  let p : 'buf<Point> = alloc_buf<Point>(2);
  p[0] = Point { x: 10, y: 11 };
  p[1] = Point { x: 20, y: 21 };
  print("{}\n", p[0].x);
  print("{}\n", p[1].x);
  drop(p);
  return 0;
}

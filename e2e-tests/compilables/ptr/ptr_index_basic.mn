// RUN: %sammine_jit --file %full | %check %full
// CHECK:      10
// CHECK-NEXT: 20
// CHECK-NEXT: 42

import std;

let unsafe main() -> i32 {
  let p : 'buf<i32> = alloc_buf<i32>(3);
  p[0] = 10;
  p[1] = 20;
  p[2] = 42;
  print("{}\n", p[0]);
  print("{}\n", p[1]);
  print("{}\n", p[2]);
  drop(p);
  return 0;
}

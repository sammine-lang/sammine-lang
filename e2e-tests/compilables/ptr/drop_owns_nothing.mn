// RUN: %sammine --file %full %O --opt-level 0 && %asan %T/%base.exe
// RUN: %sammine --file %full %O && %asan %T/%base.exe
// REQUIRES: asan

// drop(x) of a value that owns nothing does nothing: generic code drops a
// T that may be an i32.

let main() -> i32 {
  let x : i32 = 42;
  drop(x);
  return 0;
}

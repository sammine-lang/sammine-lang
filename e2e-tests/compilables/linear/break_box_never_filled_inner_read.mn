// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: ╰─ Cannot dereference '*pp' — no owned value is known to be stored there

// The inner pointer was never stored, so there is nothing to read through.

let main() -> i32 {
  let pp = alloc<'ptr<i32>>(1);
  let v = **pp;
  drop(pp);
  v
}

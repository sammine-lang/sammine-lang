// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK:          |break_addr_of_linear.mn:22:10
// CHECK-NEXT:   20|  let a = alloc<i32>(1);
// CHECK-NEXT:   21|  *a = 42;
// CHECK-NEXT:   22|  let b = &a;
// CHECK-NEXT:     |          ─┬
// CHECK-NEXT:     |           ╰─ Cannot take the address of an owned pointer: it would alias its one owner
// CHECK-NEXT:   23|  let v : i32 = *(*b);
// CHECK-NEXT:   24|  drop(a);
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

// Taking &a where a is linear creates an alias to the linear value,
// breaking the single-owner invariant.

import std;

let main() -> i32 {
  let a = alloc<i32>(1);
  *a = 42;
  let b = &a;
  let v : i32 = *(*b);
  drop(a);
  std::printf("%d\n", v);
  return 0;
}

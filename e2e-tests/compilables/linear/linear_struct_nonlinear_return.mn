// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Non-owning pointer in a struct field ('Wrapper')

// Test: returning a struct with a non-linear pointer field is an error
struct Wrapper {
  data: ptr<i32>,
  tag: i32,
};

let make_wrapper() -> Wrapper {
  let x : i32 = 42;
  let p : ptr<i32> = &x;
  let w : Wrapper = Wrapper { data: p, tag: 1 };
  return w;
}

let main() -> i32 {
  return 0;
}

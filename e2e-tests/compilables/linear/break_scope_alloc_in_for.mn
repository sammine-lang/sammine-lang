// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK:          |break_scope_alloc_in_for.mn:20:4
// CHECK-NEXT:   18|let main() -> i32 {
// CHECK-NEXT:   19|  for i in 0..1 {
// CHECK-NEXT:   20|    let q = alloc<i32>(1);
// CHECK-NEXT:     |    ───────────────────┬
// CHECK-NEXT:     |                       ╰─ Linear variable 'q' must be consumed before scope exit (use free() to deallocate)
// CHECK-NEXT:   21|    *q = 42;
// CHECK-NEXT:   22|  };
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

// A linear pointer allocated inside a loop body must be consumed there.

import std;

let main() -> i32 {
  for i in 0..1 {
    let q = alloc<i32>(1);
    *q = 42;
  };
  std::printf("done\n");
  return 0;
}

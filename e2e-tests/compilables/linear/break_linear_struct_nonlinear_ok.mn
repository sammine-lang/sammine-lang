// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Non-owning pointer in a struct field ('Wrapper')

// A non-owning ptr<T> can only be the type of a parameter or local
// variable, so storing one is rejected.

// Test: struct with non-linear pointer used locally (no return) is fine
import std;

struct Wrapper {
  data: ptr<i32>,
  tag: i32,
};

let main() -> i32 {
  let x : i32 = 99;
  let p : ptr<i32> = &x;
  let w : Wrapper = Wrapper { data: p, tag: 1 };
  std::printf("%d\n", *(w.data));
  return 0;
}

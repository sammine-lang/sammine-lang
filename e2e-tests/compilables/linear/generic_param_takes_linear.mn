// RUN: %sammine_jit --file %full | %check %full
// CHECK: 42

// A generic parameter of type T takes ownership when T is linear: pass<'buf<i64>>
// is given p, and main frees what it hands back.

import std;

let pass<T>(x: T) -> T { x }

let unsafe main() -> i32 {
  let p = alloc_buf<i64>(1);
  p[0] = 42i64;
  let q = pass<'buf<i64>>(p);
  std::printf("%ld\n", q[0]);
  drop(q);
  0
}

// RUN: %sammine --file %full %O --opt-level 0 && %asan %T/%base.exe | %check %full
// RUN: %sammine --file %full %O && %asan %T/%base.exe | %check %full
// REQUIRES: asan
// CHECK: 84

// What the ownership check once reported as left owned here, the compiler
// now drops where it goes out of use (knowledge_base/plans/drops.md).
// The leak check (%asan) finds anything left allocated or freed twice.

import std;

let double_it(x: i32) -> i32 {
  return x * 2;
}

let main() -> i32 {
  let a = alloc<i32>(1);
  *a = 42;
  let result : i32 = double_it(*a);
  std::printf("%d\n", result);
  return 0;
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: break_reassign_struct_field_alloc.mn:27:2
// CHECK-NEXT:   25|  let p = alloc<i32>(1);
// CHECK-NEXT:   26|  *p = 42;
// CHECK-NEXT:   27|  let b : Box = Box { data: p, tag: 1 };
// CHECK-NEXT:     |  ──────────────────────────────────┬
// CHECK-NEXT:     |                                    ╰─ Linear variable 'b.data' must be consumed before scope exit (use drop() to deallocate)
// CHECK-NEXT:   28|  let v : i32 = *(b.data);
// CHECK-NEXT:   29|  std::printf("%d
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

// CORRECT: p is consumed into Box{data: p}, but b.data is never freed.
// The checker now tracks inner linear fields and rejects this.

import std;

struct Box {
  data: 'ptr<i32>,
  tag: i32,
};

let main() -> i32 {
  let p = alloc<i32>(1);
  *p = 42;
  let b : Box = Box { data: p, tag: 1 };
  let v : i32 = *(b.data);
  std::printf("%d
", v);
  return 0;
}

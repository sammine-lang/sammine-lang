// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: ╰─ Reassigning linear variable '*pp' without consuming its previous value
// CHECK-NOT: ╰─

// Where the if didn't drop *pp, the store would lose what it held.

let main() -> i32 {
  let pp = alloc<'ptr<i32>>(1);
  *pp = alloc<i32>(1);
  if true { drop(*pp); };
  *pp = alloc<i32>(1);
  drop(*pp);
  drop(pp);
  0
}

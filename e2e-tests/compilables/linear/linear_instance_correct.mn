// RUN: %sammine_jit --file %full | %check %full
// CHECK: done

import std;

let a1() -> 'ptr<i32> { alloc<i32>(1) }

typeclass Probe<T> {
  Probe(a: T) -> i32;
}

instance Probe<i32> {
  let Probe(a: i32) -> i32 {
    let p = a1();
    drop(p);
    0
  }
}

let main() -> i32 {
  Probe<i32>(1);
  std::printf("done\n");
  return 0;
}

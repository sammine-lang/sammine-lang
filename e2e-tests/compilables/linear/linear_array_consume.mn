// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK:          |linear_array_consume.mn:21:2
// CHECK-NEXT:   19|let main() -> i32 {
// CHECK-NEXT:   20|  let p = alloc<i32>(1);
// CHECK-NEXT:   21|  let a : [1]'ptr<i32> = [p];
// CHECK-NEXT:     |  ────────────────────────┬
// CHECK-NEXT:     |                          ╰─ Linear variable 'a[*]' must be consumed before scope exit (use drop() to deallocate)
// CHECK-NEXT:     |                          ┬
// CHECK-NEXT:     |                          ╰─ 'p' was moved into array here
// CHECK-NEXT:   22|  drop(p);
// CHECK-NEXT:     |  ─────┬
// CHECK-NEXT:     |       ╰─ Cannot use linear variable 'p' — it was already moved into array previously
// CHECK-NEXT:   23|  return 0;
// CHECK-NEXT:   24|}
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

let main() -> i32 {
  let p = alloc<i32>(1);
  let a : [1]'ptr<i32> = [p];
  drop(p);
  return 0;
}

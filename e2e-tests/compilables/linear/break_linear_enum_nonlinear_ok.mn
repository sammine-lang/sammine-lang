// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Non-owning pointer in an enum payload ('MaybePtr')

// A non-owning ptr<T> can only be the type of a parameter or local
// variable, so storing one is rejected.

// Test: enum wrapping a non-linear pointer used locally (no return) is fine
import std;

type MaybePtr = Some(ptr<i32>) | None;

let main() -> i32 {
  let x : i32 = 99;
  let m : MaybePtr = MaybePtr::Some(&x);
  case m {
    MaybePtr::Some(p) => std::printf("got val: %d\n", *p),
    MaybePtr::None => std::printf("got nothing\n"),
  };
  return 0;
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Non-owning pointer in a return type ('[1]ptr<i32>')

// Test: returning an array with non-linear pointer elements is an error
let make_arr() -> [1]ptr<i32> {
  let x : i32 = 42;
  let p : ptr<i32> = &x;
  let a : [1]ptr<i32> = [p];
  return a;
}

let main() -> i32 {
  return 0;
}

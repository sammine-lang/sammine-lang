// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK:          |linear_struct_double_use.mn:27:2
// CHECK-NEXT:   25|  let p = alloc<i32>(1);
// CHECK-NEXT:   26|  *p = 42;
// CHECK-NEXT:   27|  let b : Box = Box { data: p, tag: 1 };
// CHECK-NEXT:     |  ──────────────────────────────────┬
// CHECK-NEXT:     |                                    ╰─ Linear variable 'b.data' must be consumed before scope exit (use drop() to deallocate)
// CHECK-NEXT:     |                            ────────┬
// CHECK-NEXT:     |                                    ╰─ 'p' was moved into struct here
// CHECK-NEXT:   28|  drop(p);
// CHECK-NEXT:     |  ─────┬
// CHECK-NEXT:     |       ╰─ Cannot use linear variable 'p' — it was already moved into struct previously
// CHECK-NEXT:   29|  return 0;
// CHECK-NEXT:   30|}
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

struct Box {
  data: 'ptr<i32>,
  tag: i32,
};

let main() -> i32 {
  let p = alloc<i32>(1);
  *p = 42;
  let b : Box = Box { data: p, tag: 1 };
  drop(p);
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK: 7

// A field two structs deep is freed through its full path.

import std;

struct In { a: 'ptr<i32> };
struct Out { i: In, n: i32 };

let main() -> i32 {
  let o = Out { i: In { a: alloc<i32>(1) }, n: 7 };
  std::printf("%d\n", o.n);
  drop(o.i.a);
  0
}

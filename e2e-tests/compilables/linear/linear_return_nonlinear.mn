// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Non-owning pointer in a return type ('ptr<i32>')

// Test: returning a stack pointer (non-linear) is an error — may dangle
let bad() -> ptr<i32> {
  let x : i32 = 42;
  let p : ptr<i32> = &x;
  return p;
}

let main() -> i32 {
  return 0;
}

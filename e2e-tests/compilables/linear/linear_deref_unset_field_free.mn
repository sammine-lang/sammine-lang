// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: ╰─ Cannot use linear variable '*p.a' — no owned value is known to be stored there

// alloc leaves *p unset, so (*p).a is not a pointer anyone allocated.

struct S { a: 'ptr<i32> };
let main() -> i32 {
  let p = alloc<S>(1);
  drop((*p).a);
  drop(p);
  0
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: ╰─ Linear variable '*pp' must be consumed before scope exit (use drop() to deallocate)

// What a call returns holds a value: dropping only the outer pointer leaks
// the inner one.

let boxed() -> 'ptr<'ptr<i32>> {
  let pp = alloc<'ptr<i32>>(1);
  *pp = alloc<i32>(1);
  pp
}

let main() -> i32 {
  let pp = boxed();
  drop(pp);
  0
}

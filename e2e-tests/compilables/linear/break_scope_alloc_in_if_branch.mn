// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: break_scope_alloc_in_if_branch.mn:22:4
// CHECK-NEXT:   20|let main() -> i32 {
// CHECK-NEXT:   21|  if (1 == 1) {
// CHECK-NEXT:   22|    let q = alloc<i32>(1);
// CHECK-NEXT:     |    ───────────────────┬
// CHECK-NEXT:     |                       ╰─ Linear variable 'q' must be consumed before scope exit (use drop() to deallocate)
// CHECK-NEXT:   23|    *q = 99;
// CHECK-NEXT:   24|  } else {
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

// CORRECT: Linear pointer allocated inside if-branch is caught at
// function scope exit by pop_scope_and_check(). Even though restore()
// doesn't remove the variable, the function-level scope check catches it.

import std;

let main() -> i32 {
  if (1 == 1) {
    let q = alloc<i32>(1);
    *q = 99;
  } else {
  };
  std::printf("done\n");
  return 0;
}

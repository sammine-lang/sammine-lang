// RUN: %sammine --file %full %O --opt-level 0 && %asan %T/%base.exe
// RUN: %sammine --file %full %O && %asan %T/%base.exe
// REQUIRES: asan

// What the ownership check once reported as left owned here, the compiler
// now drops where it goes out of use (knowledge_base/plans/drops.md):
// dropping a box drops what it points at first, and a store drops what the
// place held. The leak check (%asan) finds anything left allocated or
// freed twice.

struct S { a: 'ptr<i32> };
let main() -> i32 {
  let p = alloc<S>(1);
  *p = S { a: alloc<i32>(1) };
  *p = S { a: alloc<i32>(1) };
  drop((*p).a);
  drop(p);
  0
}

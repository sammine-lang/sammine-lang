// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: ╰─ '*p.a' was dropped here
// CHECK: ╰─ Cannot use '*p.a' — it was already dropped previously

struct S { a: 'ptr<i32> };
let main() -> i32 {
  let p = alloc<S>(1);
  *p = S { a: alloc<i32>(1) };
  drop((*p).a);
  drop((*p).a);
  drop(p);
  0
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK:          |break_short_circuit_consume.mn:26:2
// CHECK-NEXT:   24|
// CHECK-NEXT:   25|let main() -> i32 {
// CHECK-NEXT:   26|  let p = alloc<i64>(1);
// CHECK-NEXT:     |  ───────────────────┬
// CHECK-NEXT:     |                     ╰─ Linear variable 'p' is consumed in some branches but not others
// CHECK-NEXT:   27|  let ok = 1 == 2 && done(p);
// CHECK-NEXT:     |                          ┬
// CHECK-NEXT:     |                          ╰─ 'p' was passed to function here
// CHECK-NEXT:   28|  0
// CHECK-NEXT:   29|}
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

// The right side of && runs only when the left is true, so p would be freed
// on one path and leaked on the other.

let done(p: 'ptr<i64>) -> bool {
  drop(p);
  true
}

let main() -> i32 {
  let p = alloc<i64>(1);
  let ok = 1 == 2 && done(p);
  0
}

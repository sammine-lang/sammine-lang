// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: break_linear_case_wildcard_drops_payload.mn:13:7
// CHECK: ╰─ Temporary owning memory must not be discarded (bind it with 'let' first)

// A wildcard arm leaves L's payload owned and unnamed. Until drops
// (knowledge_base/plans/drops.md) drop it, the ownership check reports
// the value the case took apart, a temporary here.

type M = L('ptr<i32>) | E;
let mk() -> M { L(alloc<i32>(1)) }

let main() -> i32 {
  case mk() {
    _ => { },
  };
  return 0;
}

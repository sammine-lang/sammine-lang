// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: ╰─ Reassigning linear variable '*pp' without consuming its previous value
// CHECK-NOT: ╰─

// Where the if stored a value, the second store would lose it. Reported
// once: the place holds the new value after.

let main() -> i32 {
  let pp = alloc<'ptr<i32>>(1);
  if true { *pp = alloc<i32>(1); };
  *pp = alloc<i32>(1);
  drop(*pp);
  drop(pp);
  0
}

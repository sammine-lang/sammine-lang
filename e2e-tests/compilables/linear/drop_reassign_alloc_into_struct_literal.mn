// RUN: %sammine --file %full %O --opt-level 0 && %valgrind %T/%base.exe | %check %full
// REQUIRES: valgrind
// CHECK: 99

// What the ownership check once reported as left owned here, the compiler
// now drops where it goes out of use (knowledge_base/plans/drops.md).
// valgrind checks that all of it is freed, and freed once.

import std;

struct Box {
  data: 'ptr<i32>,
  tag: i32,
};

let main() -> i32 {
  let b : Box = Box { data: alloc<i32>(1), tag: 1 };
  *(b.data) = 99;
  let v : i32 = *(b.data);
  std::printf("%d
", v);
  return 0;
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: linear_free_double.mn
// CHECK-NEXT:    17|let main() -> i32 {
// CHECK-NEXT:    18|  let p = alloc<i32>(1);
// CHECK-NEXT:    19|  free(p);
// CHECK-NEXT:     |  ─────┬
// CHECK-NEXT:     |       ╰─ 'p' was freed here
// CHECK-NEXT:    20|  free(p);
// CHECK-NEXT:     |  ─────┬
// CHECK-NEXT:     |       ╰─ Cannot use linear variable 'p' — it was already freed previously
// CHECK-NEXT:    21|  return 0;
// CHECK-NEXT:    22|}
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

let main() -> i32 {
  let p = alloc<i32>(1);
  free(p);
  free(p);
  return 0;
}

// RUN: %sammine --file %full %O --opt-level 0 && %valgrind %T/%base.exe
// REQUIRES: valgrind

// What the ownership check once reported as left owned here, the compiler
// now drops where it goes out of use (knowledge_base/plans/drops.md).
// valgrind checks that all of it is freed, and freed once.

let a1() -> 'ptr<i32> { alloc<i32>(1) }
struct S { a: 'ptr<i32>, b: 'ptr<i32>, };

let main() -> i32 {
  S { a: a1(), b: a1() };
  return 0;
}

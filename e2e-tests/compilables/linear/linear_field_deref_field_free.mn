// RUN: %sammine_jit --file %full | %check %full
// CHECK: ok

// (*o.p).a: a field, through a pointer, through a field.

import std;
struct S { a: 'ptr<i32> };
struct O { p: 'ptr<S> };
let main() -> i32 {
  let o = O { p: alloc<S>(1) };
  *o.p = S { a: alloc<i32>(1) };
  free((*o.p).a);
  free(o.p);
  std::printf("ok\n");
  0
}

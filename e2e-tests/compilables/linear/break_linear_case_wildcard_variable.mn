// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: break_linear_case_wildcard_variable.mn:13:2
// CHECK: ╰─ Linear variable 'm.L.0' must be consumed before scope exit (use drop() to deallocate)

// A wildcard arm leaves L's payload owned and unnamed. Until drops
// (knowledge_base/plans/drops.md) drop it, the ownership check reports it
// as still owned when main returns, at m's binding.

type M = L('ptr<i32>) | E;
let mk() -> M { L(alloc<i32>(1)) }

let main() -> i32 {
  let m = mk();
  case m {
    _ => { },
  };
  return 0;
}

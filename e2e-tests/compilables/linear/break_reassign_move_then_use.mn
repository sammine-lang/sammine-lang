// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: break_reassign_move_then_use.mn
// CHECK-NEXT:   23|  let p = alloc<i32>(1);
// CHECK-NEXT:   24|  *p = 42;
// CHECK-NEXT:   25|  let q = p;
// CHECK-NEXT:     |  ────────┬
// CHECK-NEXT:     |          ╰─ 'p' was moved here
// CHECK-NEXT:   26|  drop(p);
// CHECK-NEXT:     |  ─────┬
// CHECK-NEXT:     |       ╰─ Cannot use 'p' — it was already moved previously
// CHECK-NEXT:   27|  drop(q);
// CHECK-NEXT:   28|  return 0;
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

// CORRECT: Move then free original should be caught.
// After let q = p, p is consumed. Freeing p should error.

import std;

let main() -> i32 {
  let p = alloc<i32>(1);
  *p = 42;
  let q = p;
  drop(p);
  drop(q);
  return 0;
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK:      ╰─ 'o.i.a' was dropped here
// CHECK:      ╰─ Cannot use 'o.i.a' — it was already dropped previously
// CHECK-NOT:  must be consumed before scope exit

struct In { a: 'ptr<i32> };
struct Out { i: In };

let main() -> i32 {
  let o = Out { i: In { a: alloc<i32>(1) } };
  drop(o.i.a);
  drop(o.i.a);
  0
}

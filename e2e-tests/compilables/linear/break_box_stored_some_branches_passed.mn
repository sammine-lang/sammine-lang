// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: ╰─ 'pp' must point at a value when it is passed to a function, but '*pp' holds a value in some branches only

let take(pp: 'ptr<'ptr<i32>>) -> unit {
  drop(*pp);
  drop(pp)
}

let main() -> i32 {
  let pp = alloc<'ptr<i32>>(1);
  if true { *pp = alloc<i32>(1); };
  take(pp);
  0
}

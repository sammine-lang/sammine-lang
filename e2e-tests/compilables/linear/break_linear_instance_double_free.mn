// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Cannot use linear variable 'p'

let a1() -> 'ptr<i32> { alloc<i32>(1) }

typeclass Probe<T> {
  Probe(a: T) -> i32;
}

instance Probe<i32> {
  let Probe(a: i32) -> i32 {
    let p = a1();
    drop(p);
    drop(p);
    0
  }
}

let main() -> i32 {
  return Probe<i32>(1);
}

// RUN: %sammine --file %full %O --opt-level 0 && %leakcheck %T/%base.exe
// RUN: %sammine --file %full %O && %leakcheck %T/%base.exe
// REQUIRES: leakcheck

// What the ownership check once reported as left owned here, the compiler
// now drops where it goes out of use (knowledge_base/plans/drops.md):
// dropping a box drops what it points at first, and a store drops what the
// place held. The leak check (%leakcheck) finds anything left allocated or
// freed twice.

import std;

struct Box {
  data: 'ptr<i32>,
};

let main() -> i32 {
  let inner: 'ptr<i32> = alloc<i32>(1);
  let p: 'ptr<Box> = alloc<Box>(1);
  *inner = 42;
  *p = Box { data: inner };
  drop(p);
  return 0;
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Linear variable 'a.p' must be consumed

let a1() -> 'ptr<i32> { alloc<i32>(1) }
struct W { p: 'ptr<i32>, };
let mkw() -> W { W { p: a1() } }

typeclass Probe<T> {
  Probe(a: T) -> i32;
}

instance Probe<W> {
  let Probe(a: W) -> i32 {
    0
  }
}

let main() -> i32 {
  let w = mkw();
  return Probe<W>(w);
}

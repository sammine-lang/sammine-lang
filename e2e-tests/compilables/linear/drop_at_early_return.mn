// RUN: %sammine --file %full %O --opt-level 0 && %valgrind %T/%base.exe | %check %full
// RUN: %sammine --file %full %O && %valgrind %T/%base.exe | %check %full
// REQUIRES: valgrind
// CHECK: 1 2

// The return inside the if leaves the function while p is still owned:
// p is dropped there. The other way, the program drops it itself.

import std;

let f(c: bool) -> i32 {
  let p = alloc<i32>(1);
  let r = if c { return 1; } else { 2 };
  drop(p);
  r
}

let main() -> i32 {
  std::printf("%d %d\n", f(true), f(false));
  0
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Non-owning pointer in a struct field ('HasPtr')

// Test: array of structs wrapping ptr<T> — 2 levels deep
struct HasPtr {
  p: ptr<i32>,
  tag: i32,
};

let bad() -> [1]HasPtr {
  let x : i32 = 42;
  let q : ptr<i32> = &x;
  let h : HasPtr = HasPtr { p: q, tag: 1 };
  let a : [1]HasPtr = [h];
  return a;
}

let main() -> i32 {
  return 0;
}

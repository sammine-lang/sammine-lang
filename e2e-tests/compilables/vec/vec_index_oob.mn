// RUN: (! %sammine_jit --file %full 2>&1) | %check %full
// v[i] stops at the length, not the capacity.
// CHECK: panic: index 2 out of bounds for a Vec of length 2
// CHECK-NOT: unreachable
import std;
import vec;

let main() -> i32 {
  let v = vec::push<i32>(vec::push<i32>(vec::new<i32>(4), 10), 20);
  std::printf("unreachable %d\n", v[2]);
  vec::delete<i32>(v);
  return 0;
}

// RUN: %sammine --file %full %O --opt-level 0 && %leakcheck %T/%base.exe | %check %full
// RUN: %sammine --file %full %O && %leakcheck %T/%base.exe | %check %full
// REQUIRES: leakcheck
// CHECK: 3

// A Vec nothing deletes is dropped where it goes out of use, through its
// Drop instance: each value it holds, then its buffer. Here the values own
// memory too.

import std;
import vec;

let boxed(x: i32) -> 'ptr<i32> {
  let p = alloc<i32>(1);
  *p = x;
  p
}

let main() -> i32 {
  let v = vec::new<i32>(4);
  let w = vec::new<'ptr<i32>>(1);
  let w = vec::push(w, boxed(1));
  let w = vec::push(w, boxed(2));
  let w = vec::push(w, boxed(3));
  std::printf("%lld\n", w.length);
  0
}

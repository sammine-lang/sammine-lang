// RUN: %sammine_jit --file %full | %check %full
// CHECK:      10
// CHECK-NEXT: 20
// CHECK-NEXT: 30
// CHECK-NEXT: 42
// CHECK-NEXT: 10

import std;

struct Foo { data: [3]i32, x: i32, };

let get_first(f: Foo) -> i32 {
  f.data[0]
}

let main() -> i32 {
  let f = Foo { data: [10, 20, 30], x: 42 };
  print("{}\n", f.data[0]);
  print("{}\n", f.data[1]);
  print("{}\n", f.data[2]);
  print("{}\n", f.x);
  print("{}\n", get_first(f));
  return 0;
}

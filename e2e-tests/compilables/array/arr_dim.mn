// RUN: %sammine_jit --file %full | %check %full
import std;

let main() -> i32 {
  let a : [3]i32 = [1, 2, 3];
  let (d) = dim(a);
  // CHECK: 3
  print("{}\n", d);

  let b : [2][3]i32 = [[1, 2, 3], [4, 5, 6]];
  let (rows, cols) = dim(b);
  // CHECK: 2
  print("{}\n", rows);
  // CHECK: 3
  print("{}\n", cols);

  return 0;
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Non-owning pointer in a local variable ('[3]ptr<ptr<i32>>')

// A non-owning ptr<T> can only be the type of a parameter or local
// variable, so storing one is rejected.

import std;

let main() -> i32 {
  let x : i32 = 10;
  let y : i32 = 20;
  let z : i32 = 30;
  let p : ptr<i32> = &x;
  let q : ptr<i32> = &y;
  let r : ptr<i32> = &z;
  let a : [3]ptr<ptr<i32>> = [&p, &q, &r];
  std::printf("%d\n", **a[0]);
  std::printf("%d\n", **a[1]);
  std::printf("%d\n", **a[2]);
  return 0;
}

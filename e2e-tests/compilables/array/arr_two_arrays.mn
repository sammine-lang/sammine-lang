// RUN: %sammine_jit --file %full | %check %full
// CHECK:      10
// CHECK-NEXT: 100
// CHECK-NEXT: not equal
// CHECK-NEXT: equal

import std;

let main() -> i32 {
  let a : [3]i32 = [10, 20, 30];
  let b : [3]i32 = [100, 200, 300];
  print("{}\n", (*&a)[0]);
  print("{}\n", (*&b)[0]);
  if &a == &b {
    print("equal\n");
  } else {
    print("not equal\n");
  };
  if &a == &a {
    print("equal\n");
  } else {
    print("not equal\n");
  };
  return 0;
}

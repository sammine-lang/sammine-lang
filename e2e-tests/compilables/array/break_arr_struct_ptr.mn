// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Non-owning pointer in a struct field ('Node')

// A non-owning ptr<T> can only be the type of a parameter or local
// variable, so storing one is rejected.

import std;

struct Node { id: i32, val: ptr<i32>, };

let main() -> i32 {
  let a : i32 = 42;
  let b : i32 = 99;
  let s0 : Node = Node { id: 7, val: &a };
  let s1 : Node = Node { id: 13, val: &b };
  let arr : [2]Node = [s0, s1];
  std::printf("%d\n", arr[0].id);
  std::printf("%d\n", *arr[0].val);
  std::printf("%d\n", arr[1].id);
  std::printf("%d\n", *arr[1].val);
  return 0;
}

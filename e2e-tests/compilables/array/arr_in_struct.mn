// RUN: %sammine_jit --file %full | %check %full
// CHECK:      42
// CHECK-NEXT: 7
// CHECK-NEXT: 99

import std;

struct Pair { vals: [2]i32, tag: i32, };

let get_tag(p: Pair) -> i32 {
  return p.tag;
}

let main() -> i32 {
  let p : Pair = Pair { vals: [10, 20], tag: 42 };
  let q : Pair = Pair { vals: [3, 4], tag: 7 };
  let r : Pair = Pair { vals: [0, 0], tag: 99 };
  print("{}\n", get_tag(p));
  print("{}\n", get_tag(q));
  print("{}\n", get_tag(r));
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK:      10
// CHECK-NEXT: 20
// CHECK-NEXT: 30

// Test: unannotated array literal defaults elements to i32
import std;

let main() -> i32 {
  let a = [10, 20, 30];
  print("{}\n", a[0]);
  print("{}\n", a[1]);
  print("{}\n", a[2]);
  return 0;
}

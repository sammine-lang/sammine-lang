// RUN: %sammine_jit --file %full | %check %full
// CHECK:      42
// CHECK-NEXT: 3.14

import std;

let identity<T>(x: T) -> T { x }

let apply_identity<T>(x: T) -> T {
  identity<T>(x)
}

let main() -> i32 {
  print("{}\n", apply_identity<i32>(42));
  print("{.2}\n", apply_identity<f64>(3.14));
  return 0;
}

// RUN: (! %sammine --file %full %O --diagnostics 2>&1) | %check %full
// CHECK:      Type 'T' not found in the current scope.
// CHECK:      Type 'T' not found in the current scope.
// CHECK-NOT:  poisoned
// CHECK-NOT:  Argument 1 to 'identity'

// Using T without declaring <T> should be an error, reported once: the call
// of identity, whose types that error poisoned, isn't reported again.
let identity(x: T) -> T { x }

let main() -> i32 {
  let a = identity(42);
  return 0;
}

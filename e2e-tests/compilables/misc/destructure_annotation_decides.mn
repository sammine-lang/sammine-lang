// RUN: %sammine_jit --file %full | %check %full
// CHECK: 5000000000 2 -1

import std;

let take(o: Option<i64>) -> i64 { case o { Some(v) => v, None => -1i64, } }

// A destructured variable's annotation is the type its element takes, as a
// let's is for its initializer: the literal is an i64, the None an
// Option<i64>.
let main() -> i32 {
  let (a: i64, b) = (5000000000, 2);
  let (c: Option<i64>, d) = (None, 3);
  std::printf("%ld %d %ld\n", a, b, take(c));
  0
}

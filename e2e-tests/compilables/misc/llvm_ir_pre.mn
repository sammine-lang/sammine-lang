// RUN: %sammine --file %full %O --emit llvm 2>&1 | %check %full
// The IR before LLVM optimizes it: the runtime's declarations, the
// prelude's instances, copies to inline (definitions.so defines them), and
// main, whose let names its value, so no stack slot holds it.
// CHECK:      ; ModuleID = 'LLVMDialectModule'
// CHECK-NEXT: source_filename = "LLVMDialectModule"
// CHECK-NEXT: target datalayout = "{{.*}}"
// CHECK:      declare noalias ptr @malloc(i64)
// CHECK:      declare void @free(ptr)
// CHECK:      declare void @exit(i32)
// CHECK:      define available_externally i64 @"Sized<i32>::Sized"()
// CHECK:      define i32 @main(){{.*}}{
// CHECK-NEXT:   ret i32 42
// CHECK-NEXT: }
// CHECK:      !llvm.module.flags = !{!0}
// CHECK:      !0 = !{i32 2, !"Debug Info Version", i32 3}


let main() -> i32 {
  let x: i32 = 42;
  return x;
}

// RUN: %sammine --file %full %O --llvm-ir post 2>&1 | %check %full 
// CHECK:      ; ModuleID = 'LLVMDialectModule'
// CHECK-NEXT: source_filename = "LLVMDialectModule"
// CHECK-NOT:  Sized
// CHECK:      define noundef i32 @main() local_unnamed_addr #0 {
// CHECK-NEXT:   ret i32 42
// CHECK-NEXT: }
// CHECK:      attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(none) }
// CHECK:      !llvm.module.flags = !{!0}
// CHECK:      !0 = !{i32 2, !"Debug Info Version", i32 3}

// The Sized instances from definitions.mn are internal and unused, so the
// optimizer removes them.

let main() -> i32 {
  let x: i32 = 42;
  return x;
}

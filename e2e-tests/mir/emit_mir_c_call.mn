// RUN: %sammine --file %full --emit mlir | %check %full
// A call to a C function is sammine.call to its C name: std::printf is
// printf, an llvm.func as it is variadic; abs is a func.func. An argument
// passed through `...` is passed as it is, but an owned pointer is lent, as
// C only reads it. C's promotions of variadic arguments wait for the
// lowering to LLVM.
// CHECK-LABEL: func.func private @show(
// CHECK-SAME: sammine.mir
// CHECK-NEXT: %0 = sammine.call @printf(%arg0, %arg1, %arg2, %arg3, %arg4) : (!sammine.ptr<i8, view>, i32, i8, i1, f32) -> i32
// CHECK-LABEL: func.func private @show_text(
// CHECK-SAME: sammine.mir
// CHECK-NEXT: %0 = sammine.let "text" %arg1 : !sammine.ptr<i8, owned>
// CHECK-NEXT: %1 = sammine.deref %0 : <i8, owned>
// CHECK-NEXT: %2 = sammine.lend %1 : <i8>
// CHECK-NEXT: %3 = sammine.call @printf(%arg0, %2) : (!sammine.ptr<i8, view>, !sammine.ptr<i8, view>) -> i32
// CHECK-NEXT: return %0
// CHECK-LABEL: func.func private @distance(
// CHECK-SAME: sammine.mir
// CHECK: sammine.call @abs(%{{[0-9]+}}) : (i32) -> i32
import std;

reuse abs(x: i32) -> i32;

let show(fmt: ptr<char>, a: i32, c: char, b: bool, f: f32) {
  std::printf(fmt, a, c, b, f);
}
let show_text(fmt: ptr<char>, text: 'ptr<char>) -> 'ptr<char> {
  std::printf(fmt, text);
  text
}
let distance(a: i32, b: i32) -> i32 { abs(a - b) }

let main() -> i32 { 0 }

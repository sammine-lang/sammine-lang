// RUN: %sammine --file %full --mir --emit mlir | %check %full
// A function over pointers goes through MIR with !sammine.ptr in its
// signature: 'ptr<T> is owned, ptr<T> a view. A call from code emitted from
// the AST casts its !llvm.ptr arguments to them, and the result back.
// CHECK-LABEL: func.func private @pass(%arg0: !sammine.ptr<i32, owned>{{.*}}) -> !sammine.ptr<i32, owned>
// CHECK-SAME: sammine.mir
// CHECK-NEXT: return %arg0 : !sammine.ptr<i32, owned>
// CHECK-LABEL: func.func private @pick(%arg0: !sammine.ptr<i64, view>{{.*}}, %arg1: !sammine.ptr<i64, view>{{.*}}) -> i32
// CHECK-SAME: sammine.mir
// CHECK-LABEL: func.func @main
// CHECK: builtin.unrealized_conversion_cast %{{[0-9]+}} : !llvm.ptr to !sammine.ptr<i32, owned>
// CHECK-NEXT: call @pass(%{{[0-9]+}}) : (!sammine.ptr<i32, owned>) -> !sammine.ptr<i32, owned>
// CHECK-NEXT: builtin.unrealized_conversion_cast %{{[0-9]+}} : !sammine.ptr<i32, owned> to !llvm.ptr
// CHECK: builtin.unrealized_conversion_cast %{{.*}} : !llvm.ptr to !sammine.ptr<i64, view>
// CHECK: call @pick(

let pass(p: 'ptr<i32>) -> 'ptr<i32> { p }
let pick(a: ptr<i64>, b: ptr<i64>) -> i32 { 7 }

let main() -> i32 {
  let p = alloc<i32>(1);
  *p = 41;
  let q = pass(p);
  let x: i64 = 3i64;
  let r = *q + pick(&x, &x);
  free(q);
  r - 48
}

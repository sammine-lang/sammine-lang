// RUN: %sammine --file %full --mir --emit mlir | %check %full
// A function over pointers goes through MIR with !sammine.ptr in its
// signature: 'ptr<T> is owned, ptr<T> a view. `&x` makes x's binding live in
// a slot (sammine.local), and is a view of it (sammine.addr), the same one
// each time.
// CHECK-LABEL: func.func private @pass(%arg0: !sammine.ptr<i32, owned>{{.*}}) -> !sammine.ptr<i32, owned>
// CHECK-SAME: sammine.mir
// CHECK-NEXT: return %arg0 : !sammine.ptr<i32, owned>
// CHECK-LABEL: func.func private @pick(%arg0: !sammine.ptr<i64, view>{{.*}}, %arg1: !sammine.ptr<i64, view>{{.*}}) -> i32
// CHECK-SAME: sammine.mir
// CHECK-LABEL: func.func @main
// CHECK-SAME: sammine.mir
// CHECK: %3 = sammine.local "x" : <i64>
// CHECK-NEXT: sammine.store %c3_i64, %3 : <i64>
// CHECK: sammine.addr %3 : <i64>
// CHECK-NEXT: sammine.addr %3 : <i64>
// CHECK-NEXT: sammine.call @pick(
let pass(p: 'ptr<i32>) -> 'ptr<i32> { p }
let pick(a: ptr<i64>, b: ptr<i64>) -> i32 { 7 }

let main() -> i32 {
  let p = alloc<i32>(1);
  *p = 41;
  let q = pass(p);
  let x: i64 = 3i64;
  let r = *q + pick(&x, &x);
  free(q);
  r - 48
}

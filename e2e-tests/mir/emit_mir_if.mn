// RUN: %sammine --file %full --emit mlir | %check %full
// if branches to a block for each side; a side that doesn't return goes on
// to the block after, which takes the if's value. a && b is lowered as
// if a { b } else { false }, a || b as if a { true } else { b }. Comparisons are arith.cmpi/cmpf, unsigned
// ones unsigned.
// CHECK-LABEL: func.func private @pick(
// CHECK-SAME: sammine.mir
// CHECK: %0 = arith.cmpi sgt, %arg0, %{{.*}} : i32
// CHECK-NEXT: cf.cond_br %0, ^bb1, ^bb2
// CHECK: bb3(%{{[0-9]+}}: i32{{.*}}):
// CHECK-LABEL: func.func private @sign(
// CHECK-SAME: sammine.mir
// CHECK: arith.subi %c0_i32{{.*}}, %c1_i32
// CHECK-NEXT: return
// CHECK-LABEL: func.func private @both(
// CHECK-SAME: sammine.mir
// CHECK: cf.cond_br %arg0, ^bb1, ^bb2
// CHECK: ^bb1:
// CHECK: arith.cmpi sgt
// CHECK: ^bb2:
// CHECK-NEXT: %false = arith.constant false
// CHECK: ^bb3(%[[AND:[0-9]+]]: i1{{.*}}):
// CHECK-NEXT: cf.cond_br %[[AND]], ^bb4, ^bb5
// CHECK: ^bb4:
// CHECK-NEXT: %true = arith.constant true
// CHECK: ^bb5:
// CHECK: arith.cmpi eq
// CHECK-LABEL: func.func private @below(
// CHECK: arith.cmpi ult
// CHECK: arith.cmpf olt
// CHECK-LABEL: func.func private @keep(
// CHECK-SAME: sammine.mir
// CHECK: bb3(%{{[0-9]+}}: !sammine.ptr<i32, owned>{{.*}}):

let pick(a: i32) -> i32 { if a > 0 { a } else { 0 } }
let sign(a: i32) -> i32 {
  if a < 0 { return -1; };
  if a == 0 { return 0; } else { return 1; }
}
let both(a: bool, b: i32) -> bool { (a && b > 1) || b == 0 }
let below(a: u32, b: u32, x: f64) -> bool { a < b && x < 2.0 }
let keep(p: 'ptr<i32>, q: 'ptr<i32>, first: bool) -> 'ptr<i32> {
  if first { drop(q); p } else { drop(p); q }
}

let main() -> i32 { 0 }

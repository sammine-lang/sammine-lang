// RUN: %sammine_jit --mir --file %full | %check %full
// for loops through MIR: over i32, i64 and u32, nested, and one left by a
// return from inside.
// CHECK: 45 4950 6 9
// CHECK-NEXT: 3
import std;

let sum(n: i32) -> i32 {
  let acc = alloc<i32>(1);
  *acc = 0;
  for i in 0..n { *acc = *acc + i; };
  let total = *acc;
  free(acc);
  total
}
let sum64(n: i64) -> i64 {
  let acc = alloc<i64>(1);
  *acc = 0i64;
  for i in 0i64..n { *acc = *acc + i; };
  let total = *acc;
  free(acc);
  total
}
let pairs(n: u32) -> u32 {
  let acc = alloc<u32>(1);
  *acc = 0u32;
  for i in 0u32..n { for j in 0u32..i { *acc = *acc + 1u32; }; };
  let total = *acc;
  free(acc);
  total
}
let first_square_over(limit: i32) -> i32 {
  for i in 0..100 { if i * i > limit { return i; }; };
  -1
}

let main() -> i32 {
  std::printf("%d %lld %u %d\n", sum(10), sum64(100i64), pairs(4u32), first_square_over(80));
  std::printf("%d\n", first_square_over(5));
  0
}

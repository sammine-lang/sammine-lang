// RUN: %sammine_jit --mir --file %full | %check %full
// A value made, changed, handed through a pointer to a pointer and freed by
// functions that went through MIR, read in one that didn't.
// CHECK: 42
import std;

let make(v: i32) -> 'ptr<i32> { let p = alloc<i32>(1); *p = v; p }
let bump(p: 'ptr<i32>) -> 'ptr<i32> { *p = *p + 1; p }
let release(p: 'ptr<i32>) { free(p); }
let roundtrip(p: 'ptr<i32>) -> 'ptr<i32> {
  let pp = alloc<'ptr<i32>>(1);
  *pp = p;
  let q = *pp;
  free(pp);
  q
}

let main() -> i32 {
  let p = roundtrip(bump(make(41)));
  std::printf("%d\n", *p);
  release(p);
  0
}

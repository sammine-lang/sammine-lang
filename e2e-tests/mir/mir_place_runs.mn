// RUN: %sammine_jit --file %full | %check %full
// Bindings with their address taken, through MIR: &x of a let and of a
// parameter, &x.f, &a[i], a case arm's binding, the same view twice, and
// x[i] through Indexer on a binding, a field, a temporary and a Vec.
// CHECK: 3 8 2 5 7
// CHECK-NEXT: 1 9 6
// CHECK-NEXT: 10 20 30
import std;
import vec;

struct Trio { a: i32, b: i32, c: i32 };
type Maybe = Nothing | Just(i32);

instance Indexer<Trio, i32> {
  let Indexer(t: ptr<Trio>, i: i64) -> i32 {
    if i == 0i64 { (*t).a } else if i == 1i64 { (*t).b } else { (*t).c }
  }
}

struct Holder { t: Trio };

let look(p: ptr<i32>) -> i32 { *p }
let same(p: ptr<i32>, q: ptr<i32>) -> bool { p == q }
let last(t: Trio) -> i32 { t[2i64] }
let make() -> Trio { Trio { a: 7, b: 8, c: 9 } }
let field_view(t: Trio) -> i32 { look(&t.b) }
let elem_view(a: [3]i32, i: i32) -> i32 { look(&a[i]) }
let in_arm(m: Maybe) -> i32 { case m { Maybe::Just(x) => look(&x), _ => 0 } }
let twice(n: i32) -> bool { let x = n; same(&x, &x) }

let main() -> i32 {
  let h = Holder { t: Trio { a: 1, b: 2, c: 3 } };
  std::printf("%d %d %d %d %d\n", last(h.t), make()[1i64], h.t[1i64], elem_view([4, 5, 6], 1), in_arm(Maybe::Just(7)));
  let n = 6;
  std::printf("%d %d %d\n", twice(1), field_view(Trio { a: 0, b: 9, c: 0 }), look(&n));
  let v = vec::push<i32>(vec::push<i32>(vec::new<i32>(1), 10), 20);
  std::printf("%d %d %d\n", v[0], v[1], v[0] + v[1]);
  vec::delete<i32>(v);
  0
}

// RUN: %sammine_jit --mir --file %full | %check %full
// The casts at calls into MIR disappear on the way to LLVM: the pointer
// handed through `pass` is the one main allocated.
// CHECK: 42 7
import std;

let pass(p: 'ptr<i32>) -> 'ptr<i32> { p }
let pick(a: ptr<i64>, b: ptr<i64>) -> i32 { 7 }

let main() -> i32 {
  let p = alloc<i32>(1);
  *p = 41;
  let q = pass(p);
  let x: i64 = 3i64;
  std::printf("%d %d\n", *q + 1, pick(&x, &x));
  free(q);
  0
}

// RUN: %sammine --file %full --mir --emit mlir | %check %full
// An enum with payloads is !sammine.enum, its payload's size and each
// variant's payload; a variant is sammine.variant with its payload fields'
// offsets, as the AST codegen lays them out; a case is a cf.switch on its
// tag, each arm binding its payload with sammine.payload.
// CHECK-LABEL: func.func private @wrap(
// CHECK-SAME: sammine.mir
// CHECK-NEXT: sammine.variant 1(%arg0, %arg1) at [0, 8] : (i8, i64) -> !sammine.enum<"Shape", 16, (!sammine.tuple<>, !sammine.tuple<i8, i64>)>
// CHECK-LABEL: func.func private @size(
// CHECK-SAME: sammine.mir
// CHECK-NEXT: %0 = sammine.tag %arg0
// CHECK-NEXT: cf.switch %0 : i32, [
// CHECK: sammine.payload %arg0[1, 1] at 8
type Shape = Dot | Tagged(char, i64);

let wrap(c: char, n: i64) -> Shape { Shape::Tagged(c, n) }
let size(s: Shape) -> i64 {
  case s {
    Shape::Dot => 0i64,
    Shape::Tagged(c, n) => n,
  }
}

let main() -> i32 { 0 }

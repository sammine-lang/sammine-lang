// RUN: %sammine_jit --file %full | %check %full
// CHECK:      1366

// Project Euler Problem 16: Power digit sum
// What is the sum of the digits of the number 2^1000?
// 2^1000 has 302 digits: it is held as 40 base-10^9 chunks in an owned
// buffer, least significant first.

import std;

let base() -> i64 { 1000000000i64 }
let chunks() -> i32 { 40 }

// Sets chunks i.. of `n` to zero.
let unsafe clear(n: 'ptr<i64>, i: i32) -> 'ptr<i64> {
  if i == chunks() { n } else {
    n[i] = 0i64;
    clear(n, i + 1)
  }
}

// Doubles chunks i.. of `n`, adding `carry` into chunk i.
let unsafe double(n: 'ptr<i64>, i: i32, carry: i64) -> 'ptr<i64> {
  if i == chunks() { n } else {
    let val = n[i] * 2i64 + carry;
    n[i] = val % base();
    double(n, i + 1, val / base())
  }
}

// Doubles `n` `times` times.
let double_times(n: 'ptr<i64>, times: i32) -> 'ptr<i64> {
  if times == 0 { n } else { double_times(double(n, 0, 0i64), times - 1) }
}

let digit_sum(x: i64) -> i64 {
  if x == 0i64 { 0i64 } else { x % 10i64 + digit_sum(x / 10i64) }
}

// The digit sum of chunks i.. of `n`.
let unsafe chunk_digit_sum(n: ptr<i64>, i: i32) -> i64 {
  if i == chunks() { 0i64 } else { digit_sum(n[i]) + chunk_digit_sum(n, i + 1) }
}

let unsafe main() -> i32 {
  let n = clear(alloc<i64>(chunks()), 0);
  n[0] = 1i64;
  let n = double_times(n, 1000);
  std::printf("%lld\n", chunk_digit_sum(n, 0));
  free(n);
  return 0;
}

// RUN: %sammine_jit --file %full | %check %full
// CHECK: 19 93158936107011

// Project Euler Problem 817: Digits in Squares
// M(n, d) is the least positive m whose square, written in base n, has the
// digit d. M(11, 10) = 19, as 19^2 = 361 is 2A9 in base 11. Find the sum
// of M(p, p - d) for d from 1 to 10^5, where p = 10^9 + 7.
//
// The digit p - d is the last of m^2 when m^2 = -d mod p. p is 3 mod 4, so
// a = -d has a root only if a^((p + 1) / 4) is one, and the lesser of the
// root and its negative is below p / 2. It is the digit before the last
// when m^2 / p, rounded down, is jp - d for some j >= 1: m is past
// sqrt(p (p - d)), so past p / 2 for these d, and a root, when there is
// one, is the answer. A digit further up needs m near p sqrt(p), which no
// search here comes near.

import std;
import range;

// b^e mod m, squaring b as e halves.
let pow_mod(m: i64, b: i64, e: i64) -> i64 {
  if e == 0 { 1 }
  else if e % 2 == 1 { b * pow_mod(m, b * b % m, e / 2) % m }
  else { pow_mod(m, b * b % m, e / 2) }
}

// m^2 / p rounded down, with m split as qp + r so that m^2 is never formed:
// m^2 = q^2 p^2 + 2qrp + r^2.
let square_over(p: i64, m: i64) -> i64 {
  let q = m / p;
  let r = m % p;
  q * q * p + 2 * q * r + r * r / p
}

// The least m with square_over(p, m) >= target, given that it is past lo
// and not past hi.
let least_reaching(p: i64, target: i64, lo: i64, hi: i64) -> i64 {
  if hi - lo == 1 { hi } else {
    let mid = lo + (hi - lo) / 2;
    if square_over(p, mid) >= target {
      least_reaching(p, target, lo, mid)
    } else {
      least_reaching(p, target, mid, hi)
    }
  }
}

// The least m whose square has p - d before its last digit in base p:
// m^2 / p is jp - d for the least j from the given one on that any square
// reaches exactly. jp squared is past it, so the search ends by there.
let before_last(p: i64, d: i64, j: i64) -> i64 {
  let target = j * p - d;
  let m = least_reaching(p, target, 0, j * p);
  if square_over(p, m) == target { m } else { before_last(p, d, j + 1) }
}

// M(p, p - d), for a prime p that is 3 mod 4.
let least_square(p: i64, d: i64) -> i64 {
  let r = pow_mod(p, p - d, (p + 1) / 4);
  if r * r % p == p - d {
    if r < p - r { r } else { p - r }
  } else {
    before_last(p, d, 1)
  }
}

let main() -> i32 {
  let p = 1000000007i64;
  print("{} {}\n", least_square(11, 1),
        range::sum(1, 100001, least_square(p)));
  0
}

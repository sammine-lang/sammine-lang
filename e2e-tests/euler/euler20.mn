// RUN: %sammine_jit --file %full | %check %full
// CHECK:      648

// Project Euler Problem 20: Factorial digit sum
// Find the sum of the digits in 100!
// 100! has 158 digits: it is held as 20 base-10^9 chunks in an owned buffer,
// least significant first.

import std;

let base() -> i64 { 1000000000i64 }
let chunks() -> i32 { 20 }

// Sets chunks i.. of `n` to zero.
let unsafe clear(n: 'buf<i64>, i: i32) -> 'buf<i64> {
  if i == chunks() { n } else {
    n[i] = 0i64;
    clear(n, i + 1)
  }
}

// Multiplies chunks i.. of `n` by k, adding `carry` into chunk i.
let unsafe multiply(n: 'buf<i64>, i: i32, k: i64, carry: i64) -> 'buf<i64> {
  if i == chunks() { n } else {
    let val = n[i] * k + carry;
    n[i] = val % base();
    multiply(n, i + 1, k, val / base())
  }
}

// Multiplies `n` by k, k + 1, ..., last.
let factorial_from(n: 'buf<i64>, k: i64, last: i64) -> 'buf<i64> {
  if k > last { n } else { factorial_from(multiply(n, 0, k, 0i64), k + 1i64, last) }
}

let digit_sum(x: i64) -> i64 {
  if x == 0i64 { 0i64 } else { x % 10i64 + digit_sum(x / 10i64) }
}

// The digit sum of chunks i.. of `n`.
let unsafe chunk_digit_sum(n: ptr<i64>, i: i32) -> i64 {
  if i == chunks() { 0i64 } else { digit_sum(n[i]) + chunk_digit_sum(n, i + 1) }
}

let unsafe main() -> i32 {
  let n = clear(alloc_buf<i64>(chunks()), 0);
  n[0] = 1i64;
  let n = factorial_from(n, 2i64, 100i64);
  std::printf("%lld\n", chunk_digit_sum(n, 0));
  drop(n);
  return 0;
}

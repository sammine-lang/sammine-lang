// RUN: %sammine_jit --file %full --jit-args %dir/Inputs/0022_names.txt | %check %full
// CHECK: 871198282

// Project Euler Problem 22: Names scores
// Sort the 5163 names in the file alphabetically, then score each one as its
// alphabetical value (A = 1, ..., Z = 26, summed) times its position in the
// sorted list. Find the total of all the scores.

import io;
import str;
import std;
import vec;
import range;
import buffer;

// ===--- Reading the names ---===

// The file is "MARY","PATRICIA",...: each quote and comma becomes a NUL, so
// each name is a C string in the buffer.
let unsafe blank_separator(buf: 'ptr<char>, i: i64) -> 'ptr<char> {
  if buf[i] == '"' || buf[i] == ',' { buf[i] = '\0'; };
  buf
}

// Whether a name starts at position i: a letter after a NUL or at the start.
let unsafe starts_at(buf: ptr<char>, i: i64) -> bool {
  buf[i] != '\0' && (i == 0i64 || buf[i - 1i64] == '\0')
}

// names, plus the name at position i if one starts there.
let unsafe push_name(buf: ptr<char>, names: vec::Vec<str::String>,
              i: i64) -> vec::Vec<str::String> {
  if starts_at(buf, i) { vec::push(names, str::new(&buf[i])) }
  else { names }
}

// ===--- Scoring ---===

// Whether the name at a sorts after the one at b.
let unsafe name_after(names: ptr<str::String>, a: i64, b: i64) -> bool {
  &names[a] > &names[b]
}

// A = 1, B = 2, ...
let unsafe letter_of(name: ptr<str::String>, c: i64) -> i64 {
  (*name).data[c] as i64 - 'A' as i64 + 1i64
}

// The name in sorted position k, scored.
let unsafe score_at(names: ptr<str::String>, order: ptr<i64>, k: i64) -> i64 {
  let name = &names[order[k]];
  (k + 1i64) * range::sum(0i64, (*name).length, letter_of(name))
}

let unsafe main(argc: i32, argv: ptr<ptr<char>>) -> i32 {
  case io::read_file(argv[1]) {
    Line(file, n) => {
      let buf = range::fold(0i64, n, file, blank_separator);
      let names = range::fold(0i64, n, vec::new<str::String>(16i64),
                              push_name(buf));
      let count = names.length;
      let order = buffer::indices(count)
                  |> buffer::sort_by(count, name_after(names.data));
      std::printf("%ld\n",
                  range::sum(0i64, count, score_at(names.data, order)));
      drop(order);
      drop(buffer::each(names.data, count, str::delete));
      drop(buf);
      0
    },
    Eof => {
      std::printf("could not read the names\n");
      1
    },
  }
}

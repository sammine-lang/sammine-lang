// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: panic()'s format must be a string literal: the compiler reads it to print each argument

// The compiler reads the format to pair each {} with an argument: one
// from a binding it can't read.
let main() -> i32 {
  let m = "no";
  panic(m)
}

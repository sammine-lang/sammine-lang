// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: generic_instance_per_linearity.mn:7:13
// CHECK: Linear variable 'x' must be consumed before scope exit

// eight<ptr<i64>> and eight<'ptr<i64>> are two instances. The owning one
// is checked too, and never frees what it's given.
let eight<T>(x: T) -> i64 { 8i64 }

let main() -> i32 {
  let n = 5i64;
  let a = eight(&n);
  let b = eight(alloc<i64>(1i64));
  0
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: closure_escape_via_tuple.mn:36:2
// CHECK-NEXT:   34|  let f : (i32) -> i32 = deref_add(&x);
// CHECK-NEXT:   35|  let t = (f, 0);
// CHECK-NEXT:   36|  return t;
// CHECK-NEXT:     |  ───────┬
// CHECK-NEXT:     |         ╰─ Cannot return a partial application of 'deref_add' that captured a view (ptr<T>) (may dangle after return)
// CHECK-NEXT:   37|}
// CHECK-NEXT:   38|
// CHECK-NEXT: --------------------------------------------------------------------------
// CHECK-NEXT: closure_escape_via_tuple.mn:42:2
// CHECK-NEXT:   40|  let x : i32 = 42;
// CHECK-NEXT:   41|  let f : (i32) -> i32 = deref_add(&x);
// CHECK-NEXT:   42|  return (f, 0);
// CHECK-NEXT:     |  ────────────┬
// CHECK-NEXT:     |              ╰─ Cannot return a partial application of 'deref_add' that captured a view (ptr<T>) (may dangle after return)
// CHECK-NEXT:   43|}
// CHECK-NEXT:   44|
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

// Test: closure capturing a stack ptr escapes via tuple element.
// Both inline and variable returns must be rejected.

import std;

let deref_add(p: ptr<i32>, offset: i32) -> i32 {
  return *p + offset;
}

let make_var() -> ((i32) -> i32, i32) {
  let x : i32 = 42;
  let f : (i32) -> i32 = deref_add(&x);
  let t = (f, 0);
  return t;
}

let make_inline() -> ((i32) -> i32, i32) {
  let x : i32 = 42;
  let f : (i32) -> i32 = deref_add(&x);
  return (f, 0);
}

let main() -> i32 {
  return 0;
}

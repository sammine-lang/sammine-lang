import std;

type Either<L, R> = Left(L) | Right(R);

// Each value leaves a type argument open, and nothing it goes to decides it.
let statement() -> i32 {
  None;
  0
}
let variadic() -> i32 {
  std::printf("%d", None)
}
let loop_body() -> i32 {
  for i in 0..2 { None };
  0
}
let destructured() -> i32 {
  let (a, b) = (None, 1);
  0
}
let half_known() -> i32 {
  let e = Left(1i64);
  0
}

let main() -> i32 { 0 }

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK:          |variadic_fn_value.mn:27:10
// CHECK-NEXT:   25|
// CHECK-NEXT:   26|let main() -> i32 {
// CHECK-NEXT:   27|  let p = printf;
// CHECK-NEXT:     |          ─────┬
// CHECK-NEXT:     |               ╰─ 'printf' is variadic, so it can't be used as a value; call it directly
// CHECK-NEXT:   28|  p("%d\n", 3);
// CHECK-NEXT:   29|  // Same through a module: a value, not a call with no arguments.
// CHECK-NEXT:   30|  let q = std::printf;
// CHECK-NEXT:     |          ──────────┬
// CHECK-NEXT:     |                    ╰─ 'std::printf' is variadic, so it can't be used as a value; call it directly
// CHECK-NEXT:   31|  0
// CHECK-NEXT:   32|}
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

// A function value only carries the declared parameters, so a variadic C
// function would lose its extra arguments. It must be called directly.

import std;

reuse printf(fmt: ptr<char>, ...) -> i32;

let main() -> i32 {
  let p = printf;
  p("%d\n", 3);
  // Same through a module: a value, not a call with no arguments.
  let q = std::printf;
  0
}

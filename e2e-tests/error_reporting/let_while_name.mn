// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK:          |let_while_name.mn
// CHECK-NEXT:   29|// reported once, and the compiler keeps going to find the rest.
// CHECK-NEXT:   30|
// CHECK-NEXT:   31|struct S { for: i32, };
// CHECK-NEXT:     |           ──┬
// CHECK-NEXT:     |             ╰─ 'for' is a reserved word and can't be used as a name
// CHECK-NEXT:   32|
// CHECK-NEXT:   33|let case(in: i32) -> i32 { 1 }
// CHECK-NEXT:     |    ───┬
// CHECK-NEXT:     |       ╰─ 'case' is a reserved word and can't be used as a name
// CHECK-NEXT:     |         ─┬
// CHECK-NEXT:     |          ╰─ 'in' is a reserved word and can't be used as a name
// CHECK-NEXT:   34|
// CHECK-NEXT:   35|let main() -> i32 {
// CHECK-NEXT:   36|  let while = 1;
// CHECK-NEXT:     |      ────┬
// CHECK-NEXT:     |          ╰─ 'while' is a reserved word and can't be used as a name
// CHECK-NEXT:   37|  let (a, if) = (1, 2);
// CHECK-NEXT:     |          ─┬
// CHECK-NEXT:     |           ╰─ 'if' is a reserved word and can't be used as a name
// CHECK-NEXT:   38|  0
// CHECK-NEXT:   39|}
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

// A keyword can't name a binding, function, parameter or field. Each one is
// reported once, and the compiler keeps going to find the rest.

struct S { for: i32, };

let case(in: i32) -> i32 { 1 }

let main() -> i32 {
  let while = 1;
  let (a, if) = (1, 2);
  0
}

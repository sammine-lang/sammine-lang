// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: case_non_exhaustive.mn:18:7
// CHECK-NEXT:    16|let main() -> i32 {
// CHECK-NEXT:    17|  let s: Shape = Shape::Circle(5);
// CHECK-NEXT:    18|  case s {
// CHECK-NEXT:     |       ┬
// CHECK-NEXT:     |       ╰─ Non-exhaustive case expression: missing variant(s) Point
// CHECK-NEXT:    19|    Shape::Circle(r) => r,
// CHECK-NEXT:   20|    Shape::Rect(w, h) => w,
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

type Shape = Circle(i32) | Rect(i32, i32) | Point;

let main() -> i32 {
  let s: Shape = Shape::Circle(5);
  case s {
    Shape::Circle(r) => r,
    Shape::Rect(w, h) => w,
  };
  return 0;
}

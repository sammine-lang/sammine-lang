// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Format<i32> is built in and can't be redefined
// CHECK: print() can't print 'ptr<char>': no instance of Format<ptr<char>>
// CHECK: converting a pointer to a string is only allowed in an unsafe function
// CHECK: Type mismatch: expression has type string, but variable declared as ptr<char>
// CHECK: print() can't print 'Unprintable': no instance of Format<Unprintable>
// CHECK: write() takes the Formatter to write to first: write(f, "what to say")
// CHECK: print() can't print '(i32, [2]Unprintable)': no instance of Format<Unprintable>

// A pointer to a char is no string: nothing says where its text ends, so
// it doesn't print, and only an unsafe function calls one a string. A
// type prints if it has an instance of Format, and the compiler's can't be
// written again.

instance Format<i32> {
  let Format(x: ptr<i32>, f: Formatter) -> unit { write(f, "int") }
}

struct Unprintable { x: i32, };

let main() -> i32 {
  let c = 'a';
  print("{}\n", &c);
  let p = "text" as ptr<char>;
  let s = p as string;
  let x: ptr<char> = "lit";
  print("{}\n", Unprintable { x: 1 });
  write("no formatter\n");
  // A tuple or an array prints if its parts do: the one that doesn't is named.
  print("{}\n", (1, [Unprintable { x: 1 }, Unprintable { x: 2 }]));
  0
}

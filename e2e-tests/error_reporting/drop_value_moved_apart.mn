// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: drop_value_moved_apart.mn:15:10
// CHECK: ╰─ Cannot move 'f.handle' out of 'f': 'io::File' has a Drop instance, so it drops whole; take it apart in an unsafe function

// A File's Drop closes its handle: taken out, the handle would drop as a
// pointer, freed, not closed, and the File not at all. A value whose type
// has a Drop instance drops whole, through it; only unsafe code, which
// keeps the instance's invariants itself, takes one apart, as io's own
// functions do.

import io;

let main() -> i32 {
  let f = io::open("/tmp/sammine_drop_value_moved_apart.txt", "w");
  let h = f.handle;
  0
}

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Cannot return a partial application of 'twice' that can hold itself through what it binds, so keeps that in this call's frame (may dangle after return)

// nest gives twice(f) back as an f: f's lambda set holds twice binding a
// value of f's set, so a closure of it could hold itself without end. Its
// size would have none, so it keeps what it binds in the frame of the call
// that made it, and stays in that call, as a view. A closure binding a
// closure of its own type but not of its own set is fine
// (functions/closure_self_type_returns.mn).

import std;

let add(a: i32, b: i32) -> i32 { a + b }
let twice(f: (i32) -> i32, x: i32) -> i32 { f(f(x)) }

let nest(f: (i32) -> i32, n: i32) -> (i32) -> i32 {
  if n == 0 { f } else { nest(twice(f), n - 1) }
}

let main() -> i32 {
  let g = nest(add(1), 3);
  std::printf("%d\n", g(0));
  0
}

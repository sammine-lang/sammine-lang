// RUN: (! %sammine --file %full %O --check 2>&1) | %check %full
// The return inside the if leaves the function while p is still owned.
// CHECK: linear_return_leaks_nested.mn:7:2
// CHECK: Linear variable 'p' must be consumed before scope exit

let f(c: bool) -> i32 {
  let p = alloc<i32>(1);
  let r = if c { return 1; } else { 2 };
  drop(p);
  r
}

let main() -> i32 { f(false) }

// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: as_linear_converted_twice.mn:25:14
// CHECK-NEXT:   23|let main() -> i32 {
// CHECK-NEXT:   24|  let b = Boxed { p: alloc<i32>(1) };
// CHECK-NEXT:   25|  let first = b as Plain;
// CHECK-NEXT:     |              ─────────┬
// CHECK-NEXT:     |                       ╰─ 'b' was converted here
// CHECK-NEXT:   26|  let second = b as Plain;
// CHECK-NEXT:     |               ─────────┬
// CHECK-NEXT:     |                        ╰─ Cannot use 'b' — it was already converted previously

struct Boxed { p: 'ptr<i32>, };
struct Plain { n: i32, };

instance Convert<Boxed, Plain> {
  let Convert(x: Boxed) -> Plain {
    let n = *x.p;
    drop(x.p);
    Plain { n: n }
  }
}

let main() -> i32 {
  let b = Boxed { p: alloc<i32>(1) };
  let first = b as Plain;
  let second = b as Plain;
  return 0;
}

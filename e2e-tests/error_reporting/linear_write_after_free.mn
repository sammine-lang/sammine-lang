// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: linear_write_after_free.mn
// CHECK-NEXT:    19|let main() -> i32 {
// CHECK-NEXT:    20|  let p = alloc<i32>(1);
// CHECK-NEXT:    21|  drop(p);
// CHECK-NEXT:     |  ─────┬
// CHECK-NEXT:     |       ╰─ 'p' was dropped here
// CHECK-NEXT:    22|  *p = 7;
// CHECK-NEXT:     |  ─┬
// CHECK-NEXT:     |   ╰─ Cannot dereference 'p' — it was already dropped previously
// CHECK-NEXT:   23|  std::printf("%d\n", 7);
// CHECK-NEXT:   24|  return 0;
// CHECK:      # Did something seems wrong? Report it via [https://codeberg.org/badumbatish/sammine-lang/issues]
// CHECK-NEXT: # Give us a screenshot of the error as well as your contextual source code
// CHECK-NEXT: --------------------------------------------------------------------------

import std;

let main() -> i32 {
  let p = alloc<i32>(1);
  drop(p);
  *p = 7;
  std::printf("%d\n", 7);
  return 0;
}

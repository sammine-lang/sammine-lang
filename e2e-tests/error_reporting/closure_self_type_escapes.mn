// RUN: (! %sammine --file %full %O 2>&1) | %check %full
// CHECK: Cannot return a partial application of 'twice' that binds a closure of its own type, so keeps what it binds in this call's frame (may dangle after return)

// A closure of (i32) -> i32 binding an (i32) -> i32 can't carry it: its
// size would contain itself. It keeps what it binds in the frame of the
// call that made it, and stays in that call, as a view. Used there, it
// works.

import std;

let add(a: i32, b: i32) -> i32 { a + b }
let twice(f: (i32) -> i32, x: i32) -> i32 { f(f(x)) }

let used_here(n: i32) -> i32 { let g = twice(add(n)); g(1) }
let leaves() -> (i32) -> i32 { twice(add(1)) }

let main() -> i32 {
  std::printf("%d\n", used_here(2));
  0
}

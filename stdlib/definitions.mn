// The prelude: every module imports it without writing `import`, and uses
// its names without a prefix. Like any module, it is compiled into a library
// (definitions.so), and its exported instances are linked from there.

typeclass Sized<T> {
  Sized() -> i64;
}

export instance Sized<i32> {
  let Sized() -> i64 { 4i64 }
}

export instance Sized<i64> {
  let Sized() -> i64 { 8i64 }
}

export instance Sized<f64> {
  let Sized() -> i64 { 8i64 }
}

export instance Sized<bool> {
  let Sized() -> i64 { 1i64 }
}

export instance Sized<char> {
  let Sized() -> i64 { 1i64 }
}

typeclass Add<T> {
  Add(a: T, b: T) -> T;
}

typeclass Sub<T> {
  Sub(a: T, b: T) -> T;
}

typeclass Mul<T> {
  Mul(a: T, b: T) -> T;
}

typeclass Div<T> {
  Div(a: T, b: T) -> T;
}

typeclass Mod<T> {
  Mod(a: T, b: T) -> T;
}

// The comparisons: < goes through Less, == through Equal, and so on. The
// compiler provides the instances for numbers and char, and Equal and
// NotEqual also for bool, pointers and arrays of those.
typeclass Less<T> {
  Less(a: T, b: T) -> bool;
}

typeclass Greater<T> {
  Greater(a: T, b: T) -> bool;
}

typeclass LessEqual<T> {
  LessEqual(a: T, b: T) -> bool;
}

typeclass GreaterEqual<T> {
  GreaterEqual(a: T, b: T) -> bool;
}

typeclass Equal<T> {
  Equal(a: T, b: T) -> bool;
}

typeclass NotEqual<T> {
  NotEqual(a: T, b: T) -> bool;
}

// `x as To` converts through this. The compiler provides the instances
// between the number types, and between char and the integer types.
typeclass Convert<From, To> {
  Convert(x: From) -> To;
}

typeclass Hash<T> {
  Hash(val: T) -> u64;
}

// splitmix64's finalizer: every bit of x moves every bit of the hash, so
// keys near each other, as 1, 2, 3, land far apart in a table.
let mix(x: u64) -> u64 {
  let x = (x ^ (x >> 30u64)) * 13787848793156543929u64;
  let x = (x ^ (x >> 27u64)) * 10723151780598845931u64;
  x ^ (x >> 31u64)
}

export instance Hash<i32> {
  let Hash(val: i32) -> u64 { mix(val as u64) }
}

export instance Hash<i64> {
  let Hash(val: i64) -> u64 { mix(val as u64) }
}

export instance Hash<u32> {
  let Hash(val: u32) -> u64 { mix(val as u64) }
}

export instance Hash<u64> {
  let Hash(val: u64) -> u64 { mix(val) }
}

export instance Hash<char> {
  let Hash(val: char) -> u64 { mix(val as u64) }
}

export instance Hash<bool> {
  let Hash(val: bool) -> u64 { mix(if val { 1u64 } else { 0u64 }) }
}

// coll[idx], for a coll that is neither an array nor a pointer. The
// collection is lent, so indexing doesn't use it up.
// What a value of type T does when it ends, where it goes out of use or at
// drop(x): it is given the value, and must use up what it owns. A type with
// no instance drops part by part.
typeclass Drop<T> {
  Drop(x: T) -> unit;
}

typeclass Indexer<T, E> {
  Indexer(coll: ptr<T>, idx: i64) -> E;
}

export type Option<T> = Some(T) | None;

typeclass Iterator<I, T> {
  next(iter : I) -> Option<(I, T)>;
}

export struct Range<T> {
  current: T,
  end_val: T,
};

export instance Iterator<Range<i32>, i32> {
  let next(iter: Range<i32>) -> Option<(Range<i32>, i32)> {
    if iter.current < iter.end_val {
      Option<(Range<i32>, i32)>::Some((Range<i32> { current: iter.current + 1i32, end_val: iter.end_val }, iter.current))
    } else {
      Option<(Range<i32>, i32)>::None
    }
  }
}

export instance Iterator<Range<i64>, i64> {
  let next(iter: Range<i64>) -> Option<(Range<i64>, i64)> {
    if iter.current < iter.end_val {
      Option<(Range<i64>, i64)>::Some((Range<i64> { current: iter.current + 1i64, end_val: iter.end_val }, iter.current))
    } else {
      Option<(Range<i64>, i64)>::None
    }
  }
}

export instance Iterator<Range<u32>, u32> {
  let next(iter: Range<u32>) -> Option<(Range<u32>, u32)> {
    if iter.current < iter.end_val {
      Option<(Range<u32>, u32)>::Some((Range<u32> { current: iter.current + 1u32, end_val: iter.end_val }, iter.current))
    } else {
      Option<(Range<u32>, u32)>::None
    }
  }
}

export instance Iterator<Range<u64>, u64> {
  let next(iter: Range<u64>) -> Option<(Range<u64>, u64)> {
    if iter.current < iter.end_val {
      Option<(Range<u64>, u64)>::Some((Range<u64> { current: iter.current + 1u64, end_val: iter.end_val }, iter.current))
    } else {
      Option<(Range<u64>, u64)>::None
    }
  }
}

typeclass Sized<T> {
  Sized() -> i64;
}

instance Sized<i32> {
  let Sized() -> i64 { 4i64 }
}

instance Sized<i64> {
  let Sized() -> i64 { 8i64 }
}

instance Sized<f64> {
  let Sized() -> i64 { 8i64 }
}

instance Sized<bool> {
  let Sized() -> i64 { 1i64 }
}

instance Sized<char> {
  let Sized() -> i64 { 1i64 }
}

typeclass Add<T> {
  Add(a: T, b: T) -> T;
}

typeclass Sub<T> {
  Sub(a: T, b: T) -> T;
}

typeclass Mul<T> {
  Mul(a: T, b: T) -> T;
}

typeclass Div<T> {
  Div(a: T, b: T) -> T;
}

typeclass Mod<T> {
  Mod(a: T, b: T) -> T;
}

// `x as To` converts through this. The compiler provides the instances
// between the number types, and between char and the integer types.
typeclass Convert<From, To> {
  Convert(x: From) -> To;
}

typeclass Hash<T> {
  Hash(val: T) -> u64;
}

typeclass Indexer<T, E> {
  Indexer(coll: T, idx: i64) -> E;
}

type Option<T> = Some(T) | None;

typeclass Iterator<I, T> {
  next(iter : I) -> Option<(I, T)>;
}

struct Range<T> {
  current: T,
  end_val: T,
};

instance Iterator<Range<i32>, i32> {
  let next(iter: Range<i32>) -> Option<(Range<i32>, i32)> {
    if iter.current < iter.end_val {
      Option<(Range<i32>, i32)>::Some((Range<i32> { current: iter.current + 1i32, end_val: iter.end_val }, iter.current))
    } else {
      Option<(Range<i32>, i32)>::None
    }
  }
}

instance Iterator<Range<i64>, i64> {
  let next(iter: Range<i64>) -> Option<(Range<i64>, i64)> {
    if iter.current < iter.end_val {
      Option<(Range<i64>, i64)>::Some((Range<i64> { current: iter.current + 1i64, end_val: iter.end_val }, iter.current))
    } else {
      Option<(Range<i64>, i64)>::None
    }
  }
}

instance Iterator<Range<u32>, u32> {
  let next(iter: Range<u32>) -> Option<(Range<u32>, u32)> {
    if iter.current < iter.end_val {
      Option<(Range<u32>, u32)>::Some((Range<u32> { current: iter.current + 1u32, end_val: iter.end_val }, iter.current))
    } else {
      Option<(Range<u32>, u32)>::None
    }
  }
}

instance Iterator<Range<u64>, u64> {
  let next(iter: Range<u64>) -> Option<(Range<u64>, u64)> {
    if iter.current < iter.end_val {
      Option<(Range<u64>, u64)>::Some((Range<u64> { current: iter.current + 1u64, end_val: iter.end_val }, iter.current))
    } else {
      Option<(Range<u64>, u64)>::None
    }
  }
}

import str;

export reuse printf(fmt: string, ...) -> i32;
// C hands back what it reads as new values: a buffer and its length, plus
// the file handle for a file read. It never writes into sammine memory.
reuse sammine_io_read_line() -> ('buf<char>, i64);
reuse sammine_io_read_i32() -> i32;
reuse sammine_io_read_i64() -> i64;
reuse sammine_io_read_f64() -> f64;
reuse sammine_io_open(path: string, mode: string) -> 'ptr<char>;
reuse sammine_io_close(handle: 'ptr<char>) -> unit;
reuse sammine_io_file_read_line(handle: 'ptr<char>) -> ('ptr<char>, 'buf<char>, i64);
reuse sammine_io_file_write(handle: 'ptr<char>, content: ptr<char>, nbytes: i64) -> 'ptr<char>;
reuse sammine_io_read_file(path: string) -> ('buf<char>, i64);
reuse sammine_io_write_file(path: string, content: ptr<char>, nbytes: i64) -> i32;
reuse sammine_io_append_file(path: string, content: ptr<char>, nbytes: i64) -> i32;

export let print_i32(n: i32) -> unit { print("{}", n); }
export let print_i64(n: i64) -> unit { print("{}", n); }
export let print_f64(n: f64) -> unit { print("{}", n); }
export let print_char(c: char) -> unit { print("{}", c); }
export let print_bool(b: bool) -> unit { print("{}", b); }


// What a read produced: the text, a String the caller owns, or None when
// there was nothing to read. C signals that with a NULL buffer and a
// negative length: dropping NULL frees nothing, but it consumes the buffer.
let to_text(buf: 'buf<char>, n: i64) -> Option<str::String> {
  if n < 0i64 {
    drop(buf);
    Option<str::String>::None
  } else {
    Option<str::String>::Some(str::String { data: buf, length: n, cap: n })
  }
}

// The next line of stdin, without its newline.
export let unsafe read_line() -> Option<str::String> {
  let (buf, n) = sammine_io_read_line();
  to_text(buf, n)
}
export let unsafe read_i32() -> i32 { sammine_io_read_i32() }
export let unsafe read_i64() -> i64 { sammine_io_read_i64() }
export let unsafe read_f64() -> f64 { sammine_io_read_f64() }

// An open file: C's FILE *, which close closes. It is a struct of its own,
// not the pointer, so that its drop closes it: a pointer's would free it.
export struct File { handle: 'ptr<char>, };

export instance Drop<File> {
  let unsafe Drop(f: File) -> unit { sammine_io_close(f.handle) }
}

export let unsafe open(path: string, mode: string) -> File {
  File { handle: sammine_io_open(path, mode) }
}
export let close(f: File) -> unit { drop(f) }
// Returns the file back with the next line.
export let unsafe file_read_line(f: File) -> (File, Option<str::String>) {
  let (handle, buf, n) = sammine_io_file_read_line(f.handle);
  (File { handle: handle }, to_text(buf, n))
}
export let unsafe file_write(f: File, content: ptr<char>, nbytes: i64) -> File {
  File { handle: sammine_io_file_write(f.handle, content, nbytes) }
}

// All of the file, or None if it cannot be read.
export let unsafe read_file(path: string) -> Option<str::String> {
  let (buf, n) = sammine_io_read_file(path);
  to_text(buf, n)
}
export let unsafe write_file(path: string, content: ptr<char>, nbytes: i64) -> i32 {
  sammine_io_write_file(path, content, nbytes)
}
export let unsafe append_file(path: string, content: ptr<char>, nbytes: i64) -> i32 {
  sammine_io_append_file(path, content, nbytes)
}

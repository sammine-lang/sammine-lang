export reuse printf(fmt: ptr<char>, ...) -> i32;
reuse sammine_io_eprint(s: ptr<char>) -> unit;
reuse sammine_io_eprintln(s: ptr<char>) -> unit;
// C hands back what it reads as new values: a buffer and its length, plus
// the file handle for a file read. It never writes into sammine memory.
reuse sammine_io_read_line() -> ('buf<char>, i64);
reuse sammine_io_read_i32() -> i32;
reuse sammine_io_read_i64() -> i64;
reuse sammine_io_read_f64() -> f64;
reuse sammine_io_open(path: ptr<char>, mode: ptr<char>) -> 'ptr<char>;
reuse sammine_io_close(handle: 'ptr<char>) -> unit;
reuse sammine_io_file_read_line(handle: 'ptr<char>) -> ('ptr<char>, 'buf<char>, i64);
reuse sammine_io_file_write(handle: 'ptr<char>, content: ptr<char>, nbytes: i64) -> 'ptr<char>;
reuse sammine_io_read_file(path: ptr<char>) -> ('buf<char>, i64);
reuse sammine_io_write_file(path: ptr<char>, content: ptr<char>, nbytes: i64) -> i32;
reuse sammine_io_append_file(path: ptr<char>, content: ptr<char>, nbytes: i64) -> i32;

export let print(s: ptr<char>) -> unit { printf("%s", s); }
export let println(s: ptr<char>) -> unit { printf("%s\n", s); }
export let print_i32(n: i32) -> unit { printf("%d", n); }
export let print_i64(n: i64) -> unit { printf("%ld", n); }
export let print_f64(n: f64) -> unit { printf("%f", n); }
export let print_char(c: char) -> unit { printf("%c", c); }
export let print_bool(b: bool) -> unit { if b { printf("true") } else { printf("false") }; }

export let eprint(s: ptr<char>) -> unit { sammine_io_eprint(s) }
export let eprintln(s: ptr<char>) -> unit { sammine_io_eprintln(s) }

// What a read produced: a buffer the caller owns and its length, or Eof when
// there was nothing to read.
export type ReadResult = Line('buf<char>, i64) | Eof;

// The runtime signals "nothing to read" with a NULL buffer and a negative
// length. Dropping NULL frees nothing, but it consumes the owned buffer.
let to_read_result(buf: 'buf<char>, n: i64) -> ReadResult {
  if n < 0i64 { drop(buf); Eof } else { Line(buf, n) }
}

export let read_line() -> ReadResult {
  let (buf, n) = sammine_io_read_line();
  to_read_result(buf, n)
}
export let read_i32() -> i32 { sammine_io_read_i32() }
export let read_i64() -> i64 { sammine_io_read_i64() }
export let read_f64() -> f64 { sammine_io_read_f64() }

// An open file: C's FILE *, which close closes. It is a struct of its own,
// not the pointer, so that its drop closes it: a pointer's would free it.
export struct File { handle: 'ptr<char>, };

export instance Drop<File> {
  let unsafe Drop(f: File) -> unit { sammine_io_close(f.handle) }
}

export let open(path: ptr<char>, mode: ptr<char>) -> File {
  File { handle: sammine_io_open(path, mode) }
}
export let close(f: File) -> unit { drop(f) }
// Returns the file back with the next line.
export let unsafe file_read_line(f: File) -> (File, ReadResult) {
  let (handle, buf, n) = sammine_io_file_read_line(f.handle);
  (File { handle: handle }, to_read_result(buf, n))
}
export let unsafe file_write(f: File, content: ptr<char>, nbytes: i64) -> File {
  File { handle: sammine_io_file_write(f.handle, content, nbytes) }
}

// Eof if the file cannot be read.
export let read_file(path: ptr<char>) -> ReadResult {
  let (buf, n) = sammine_io_read_file(path);
  to_read_result(buf, n)
}
export let write_file(path: ptr<char>, content: ptr<char>, nbytes: i64) -> i32 {
  sammine_io_write_file(path, content, nbytes)
}
export let append_file(path: ptr<char>, content: ptr<char>, nbytes: i64) -> i32 {
  sammine_io_append_file(path, content, nbytes)
}

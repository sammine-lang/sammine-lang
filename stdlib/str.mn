reuse malloc(size: i64) -> 'buf<char>;
// memcpy returns dst, so ownership of the buffer is handed back.
reuse memcpy(dst: 'buf<char>, src: ptr<char>, n: i64) -> 'buf<char>;
reuse strlen(s: ptr<char>) -> i64;

// `data` is always NUL-terminated. `cap` counts the characters that fit,
// like Vec's cap; the buffer holds one more byte for the terminator, so
// every allocation here is `cap + 1` bytes.
export struct String {
  data: 'buf<char>,
  length: i64,
  cap: i64,
};

export let new(src: ptr<char>) -> String {
  let sz: i64 = strlen(src);
  // Copy the terminator along with the characters.
  let buf = malloc(sz + 1i64);
  let buf = memcpy(buf, src, sz + 1i64);
  String { data: buf, length: sz, cap: sz }
}

export instance Drop<String> {
  let unsafe Drop(s: String) -> unit { drop(s.data) }
}

export let delete(s: String) -> unit {
  drop(s)
}

// How many characters s holds, its terminator not counted.
export let length(s: ptr<String>) -> i64 { (*s).length }

// Character i of s, or None outside 0..length(s): s[i] that doesn't end
// the program.
export let unsafe get(s: ptr<String>, i: i64) -> Option<char> {
  if i < 0i64 || i >= (*s).length {
    Option<char>::None
  } else {
    Option<char>::Some((*s).data[i])
  }
}

// A buffer with room for c characters and the terminator, holding the
// first n of data and its terminator. data is freed.
let unsafe grow(data: 'buf<char>, n: i64, c: i64) -> 'buf<char> {
  let bigger = memcpy(malloc(c + 1i64), data, n + 1i64);
  drop(data);
  bigger
}

// Room for at least need characters: s's, or twice it, or need.
let room(cap: i64, need: i64) -> i64 {
  if need <= cap {
    cap
  } else if need <= cap * 2i64 {
    cap * 2i64
  } else {
    need
  }
}

// s with room for need characters and the terminator.
let unsafe reserve(s: String, need: i64) -> String {
  let cap = room(s.cap, need);
  let data = if cap == s.cap { s.data } else { grow(s.data, s.length, cap) };
  String { data: data, length: s.length, cap: cap }
}

// s with c after its characters.
export let unsafe push(s: String, c: char) -> String {
  let s = reserve(s, s.length + 1i64);
  s.data[s.length] = c;
  s.data[s.length + 1i64] = '\0';
  String { data: s.data, length: s.length + 1i64, cap: s.cap }
}

// s with the characters of t after its own.
export let unsafe append(s: String, t: ptr<char>) -> String {
  let n = strlen(t);
  let s = reserve(s, s.length + n);
  // t's terminator too.
  for i in 0i64..n + 1i64 {
    s.data[s.length + i] = t[i];
  };
  String { data: s.data, length: s.length + n, cap: s.cap }
}

// s[i]: byte i of the first s.length, the terminator not among them. An
// index outside them ends the program.
export instance Indexer<String, char> {
  let unsafe Indexer(s: ptr<String>, i: i64) -> char {
    if i < 0i64 || i >= (*s).length {
      panic("index %lld out of bounds for a String of length %lld", i,
            (*s).length)
    } else {
      (*s).data[i]
    }
  }
}

reuse strcmp(a: ptr<char>, b: ptr<char>) -> i32;

// Negative, zero or positive as `a` sorts before, with, or after `b`, byte
// by byte as C's strcmp does.
export let compare(a: ptr<String>, b: ptr<String>) -> i32 {
  strcmp((*a).data, (*b).data)
}

// Whether a and b hold the same characters. `==` on two views compares
// where they point, as for any pointer; this compares what they hold.
export let eq(a: ptr<String>, b: ptr<String>) -> bool {
  (*a).length == (*b).length && compare(a, b) == 0
}

// Strings are ordered through views, &a < &b: a comparison only reads them.
export instance Less<ptr<String>> {
  let Less(a: ptr<String>, b: ptr<String>) -> bool { compare(a, b) < 0 }
}

export instance Greater<ptr<String>> {
  let Greater(a: ptr<String>, b: ptr<String>) -> bool { compare(a, b) > 0 }
}

export instance LessEqual<ptr<String>> {
  let LessEqual(a: ptr<String>, b: ptr<String>) -> bool { compare(a, b) <= 0 }
}

export instance GreaterEqual<ptr<String>> {
  let GreaterEqual(a: ptr<String>, b: ptr<String>) -> bool {
    compare(a, b) >= 0
  }
}

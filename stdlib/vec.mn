export struct Vec<T> {
  data: 'buf<T>,
  length: i64,
  cap: i64,
};

// v[i]: element i of the first v.length. An index outside them ends the
// program.
export instance<T> Indexer<Vec<T>, T> {
  let unsafe Indexer(v: ptr<Vec<T>>, i: i64) -> T {
    if i < 0i64 || i >= (*v).length {
      panic("index %lld out of bounds for a Vec of length %lld", i,
            (*v).length)
    } else {
      (*v).data[i]
    }
  }
}

export let new<T>(cap: i64) -> Vec<T> {
  Vec<T> { data: alloc_buf<T>(cap), length: 0i64, cap: cap }
}

let unsafe grow_buf<T>(old_d: 'buf<T>, l: i64, old_c: i64) -> 'buf<T> {
  let new_c = old_c * 2i64;
  let new_d = alloc_buf<T>(new_c);
  for i in 0i64..l {
    new_d[i] = old_d[i];
  };
  drop(old_d);
  new_d
}

export let unsafe push<T>(v: Vec<T>, val: T) -> Vec<T> {
  if v.length == v.cap {
    let d2 = grow_buf<T>(v.data, v.length, v.cap);
    d2[v.length] = val;
    Vec<T> { data: d2, length: v.length + 1i64, cap: v.cap * 2i64 }
  } else {
    v.data[v.length] = val;
    Vec<T> { data: v.data, length: v.length + 1i64, cap: v.cap }
  }
}

// A Vec's drop drops the values it holds, then its buffer: the buffer's
// own drop only frees it.
export instance<T> Drop<Vec<T>> {
  let unsafe Drop(v: Vec<T>) -> unit {
    for i in 0i64..v.length { drop(v.data[i]); };
    drop(v.data)
  }
}

export let delete<T>(v: Vec<T>) -> unit {
  drop(v)
}
